};

function reverseDigitsToArabic(n) {
  const map = {'0':'٠','1':'١','2':'٢','3':'٣','4':'٤','5':'٥','6':'٦','7':'٧','8':'٨','9':'٩'};
  return n.split('').map(c => map[c]||c).join('');
}
function toArabicLetter(c) {
  const map = {A:'أ',B:'ب',C:'ج',D:'د',E:'ه',F:'و',G:'ز',H:'ح',I:'ط',J:'ي',K:'ك',L:'ل',M:'م',N:'ن',O:'س',P:'ع',Q:'ف',R:'ص',S:'ق',T:'ر',U:'ش',V:'ت',W:'ث',X:'خ',Y:'ذ',Z:'ظ'};
  return map[c.toUpperCase()] || c;
}

// ── Plate preview ─────────────────────────────────────────────────────────────
function updatePlatePreview() {
  const src  = document.getElementById('cs-source-val').dataset.value || '';
  const code = document.getElementById('cs-code-val').dataset.value   || '';
  const no   = (document.getElementById('plateNo')?.value || '').trim();
  const overlay = document.getElementById('plate-overlay');

  if (!src && !code && !no) {
    overlay.style.display = 'none';
    return;
  }
  overlay.style.display = '';

  const renderer = PLATE_STYLES[src] || PLATE_STYLES.DXB;
  overlay.innerHTML = renderer(code, no);
}

// ── Search / validation ───────────────────────────────────────────────────────
function showError(msg) { const el = document.getElementById('form-error'); el.textContent = msg; el.style.display = ''; }
function hideError()    { document.getElementById('form-error').style.display = 'none'; }

function handleSearch() {
  hideError();
  const plateSrc  = document.getElementById('cs-source-val').dataset.value || '';
  const plateCode = document.getElementById('cs-code-val').dataset.value   || '';
  const plateNo   = (document.getElementById('plateNo').value || '').trim();

  if (!plateSrc)  { showError('Please select a plate source.'); return; }
  if (!plateNo)   { showError('Please enter your plate number.'); return; }
  if (!plateCode) { showError('Please select a plate code.');   return; }

  const plateCodeEntry = PLATE_CODES.find(c => c.code === plateCode);
  const plateCodeId    = plateCodeEntry ? plateCodeEntry.id : '0';
  const plateCat       = '2';

  const btn = document.getElementById('search-btn');
  btn.disabled = true;
  btn.innerHTML = '<span style="width:18px;height:18px;border:3px solid rgba(255,255,255,0.35);border-top-color:white;border-radius:50%;display:inline-block;animation:spin 0.8s linear infinite;"></span>';

  const params = new URLSearchParams({
    plateNo,
    plateCat,
    plateSrcCode:    plateSrc,
    plateCodeId,
    plateCodeLetter: plateCode,
  });
  window.location.href = '/fines?' + params.toString();
}

// ── Init ─────────────────────────────────────────────────────────────────────
csRenderList('source', PLATE_SOURCES.map(s => ({value: s.code, label: s.label})));
csRenderList('code',   PLATE_CODES.map(c   => ({value: c.code, label: c.code})));

// Video: pause at last frame (no loop already removed from HTML)
document.getElementById('plate-video').addEventListener('ended', function() {
  this.pause();
});

</script>
</body>
</html>
