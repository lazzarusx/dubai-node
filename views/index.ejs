<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Inquire &amp; Pay | Dubai Police</title>
<link rel="icon" type="image/png" href="/dp-logo.png">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --green:     #006837;
  --green-lt:  #e8f5ee;
  --border:    #e5e7eb;
  --bg:        #f5f7fa;
  --text:      #1a1a1a;
  --muted:     #6b7280;
  --sidebar-w: 60px;
}
html, body { height: 100%; }
body { font-family: 'Inter', -apple-system, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ── Top header ── */
.topbar {
  height: 52px; background: white; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 12px;
  padding: 0 14px; position: sticky; top: 0; z-index: 50;
  flex-shrink: 0;
}
.topbar-back { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border); background: white; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
.topbar-back svg { width: 16px; height: 16px; stroke: var(--muted); fill: none; stroke-width: 2; stroke-linecap: round; }
.breadcrumb { display: flex; align-items: center; gap: 5px; font-size: 13px; color: var(--muted); flex: 1; }
.breadcrumb span { color: var(--muted); }
.breadcrumb .current { color: var(--text); font-weight: 600; }
.breadcrumb-sep { font-size: 10px; color: #cbd5e1; }
.topbar-icons { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.topbar-icon { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--border); background: white; display: flex; align-items: center; justify-content: center; cursor: pointer; }
.topbar-icon svg { width: 14px; height: 14px; stroke: var(--muted); fill: none; stroke-width: 2; }
.lang-btn { padding: 4px 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 12px; font-weight: 600; color: var(--text); background: white; cursor: pointer; }
.sos-btn { padding: 4px 12px; background: #dc2626; color: white; border: none; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; }
.login-btn { display: flex; align-items: center; gap: 5px; font-size: 12px; color: var(--muted); cursor: pointer; background: none; border: none; }

/* ── Layout ── */
.app-layout { display: flex; flex: 1; min-height: 0; }

/* ── Sidebar ── */
.sidebar {
  width: var(--sidebar-w); background: white; border-right: 1px solid var(--border);
  display: flex; flex-direction: column; align-items: center;
  padding: 8px 0; gap: 2px; flex-shrink: 0; overflow-y: auto;
}
.sidebar-logo { width: 44px; height: 44px; margin-bottom: 6px; }
.sidebar-logo img { width: 100%; height: 100%; object-fit: contain; }
.sb-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.12s; }
.sb-icon:hover { background: var(--green-lt); }
.sb-icon.active { background: var(--green-lt); }
.sb-icon svg { width: 19px; height: 19px; stroke: var(--muted); fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.sb-icon.active svg { stroke: var(--green); }
@media (max-width: 600px) { .sidebar { display: none; } }

/* ── Main ── */
.main-area { flex: 1; display: flex; flex-direction: column; overflow-y: auto; min-width: 0; }

/* ── Car banner ── */
.car-banner-wrap {
  position: relative; width: 100%; background: #dde6dc;
  overflow: hidden; max-height: 280px; flex-shrink: 0;
}
.car-banner-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.plate-overlay {
  position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);
  background: white; border: 2px solid rgba(0,0,0,0.15);
  border-radius: 6px; padding: 8px 18px 6px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.28);
  min-width: 200px; text-align: center;
  display: flex; flex-direction: column; align-items: center; gap: 1px;
}
.plate-top { display: flex; align-items: center; gap: 8px; }
.plate-src-txt { font-size: 11px; font-weight: 700; color: var(--muted); letter-spacing: 0.5px; }
.plate-uae { font-size: 11px; font-weight: 800; color: #333; letter-spacing: 2px; }
.plate-num { font-size: 22px; font-weight: 900; color: var(--text); letter-spacing: 3px; line-height: 1; }
.plate-code-txt { font-size: 13px; font-weight: 700; color: #444; margin-left: 6px; }
.plate-empty { font-size: 13px; color: #aaa; letter-spacing: 1px; }

/* ── Tab nav ── */
.tab-nav {
  background: white; border-bottom: 1px solid var(--border);
  padding: 0 16px; display: flex; gap: 0; overflow-x: auto;
  scrollbar-width: none; flex-shrink: 0;
}
.tab-nav::-webkit-scrollbar { display: none; }
.tab-btn {
  padding: 11px 14px; border: none; background: none; font-size: 13px;
  cursor: pointer; white-space: nowrap; margin-bottom: -1px;
  font-weight: 500; color: var(--muted); border-bottom: 2.5px solid transparent;
  display: flex; align-items: center; gap: 7px; transition: all 0.12s;
}
.tab-btn.active { font-weight: 700; color: var(--green); border-bottom-color: var(--green); }
.tab-btn svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; }

/* ── Form section ── */
.form-area { flex: 1; padding: 20px 16px; background: white; margin: 12px; border-radius: 14px; border: 1px solid var(--border); }
.form-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
@media (max-width: 640px) { .form-grid { grid-template-columns: 1fr; } }
.field-label { font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 6px; display: block; }
.field-wrap { position: relative; }
.form-input, .form-select {
  width: 100%; padding: 11px 14px; border: 1.5px solid var(--border);
  border-radius: 10px; font-size: 14px; color: var(--text);
  background: white; outline: none; appearance: none;
  font-family: inherit; transition: border-color 0.15s;
}
.form-input:focus, .form-select:focus { border-color: var(--green); box-shadow: 0 0 0 3px rgba(0,104,55,0.1); }
.form-select { padding-right: 36px; }
.select-arrow {
  position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
  pointer-events: none;
}
.select-arrow svg { width: 14px; height: 14px; stroke: var(--muted); fill: none; stroke-width: 2; }
.form-error { display: none; margin-top: 12px; padding: 10px 14px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; font-size: 13px; color: #dc2626; }

/* ── Bottom actions ── */
.bottom-actions {
  background: white; border-top: 1px solid var(--border);
  padding: 14px 16px; display: flex; gap: 10px; flex-shrink: 0;
  position: sticky; bottom: 0;
}
.btn-back {
  flex: 1; padding: 14px; border: 1.5px solid var(--border); background: white;
  border-radius: 50px; font-size: 14px; font-weight: 600; color: var(--muted);
  cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px;
}
.btn-check {
  flex: 2; padding: 14px; background: var(--green); color: white;
  border: none; border-radius: 50px; font-size: 14px; font-weight: 700;
  cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
  box-shadow: 0 4px 16px rgba(0,104,55,0.35); transition: background 0.15s;
}
.btn-check:hover { background: #005229; }
.btn-check:disabled { background: #9ca3af; box-shadow: none; cursor: not-allowed; }
.btn-icon { width: 22px; height: 22px; background: rgba(255,255,255,0.25); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.btn-icon svg { width: 12px; height: 12px; stroke: white; fill: none; stroke-width: 2.5; }
</style>
</head>
<body>

<!-- Top header -->
<div class="topbar">
  <div class="topbar-back" onclick="history.back()">
    <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
  </div>
  <div class="breadcrumb">
    <span>Services</span>
