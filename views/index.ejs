    <!-- Form card -->
    <div class="form-card">
      <div class="form-area">
        <div class="form-grid">

          <!-- Plate Source -->
          <div>
            <label class="field-label">Plate Source</label>
            <div class="cs-wrap" id="cs-source-wrap">
              <div class="cs-trigger" id="cs-source-trigger" onclick="csToggle('source')">
                <span id="cs-source-val" class="cs-val-txt empty" data-value="">Select Source</span>
                <div class="cs-trigger-right">
                  <button class="cs-clear" id="cs-source-clear" onclick="event.stopPropagation();csClear('source')" style="display:none;">×</button>
                  <svg class="cs-chevron" id="cs-source-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
              </div>
              <div class="cs-panel" id="cs-source-panel" style="display:none;">
                <div class="cs-list" id="cs-source-list"></div>
              </div>
            </div>
          </div>

          <!-- Plate Number -->
          <div>
            <label class="field-label">Plate Number</label>
            <input type="number" inputmode="numeric" id="plateNo" class="form-input" placeholder="Enter plate number" oninput="updatePlatePreview()">
          </div>

          <!-- Plate Code -->
          <div>
            <label class="field-label">Plate Code</label>
            <div class="cs-wrap" id="cs-code-wrap">
              <div class="cs-trigger" id="cs-code-trigger" onclick="csToggle('code')">
                <span id="cs-code-val" class="cs-val-txt empty" data-value="">Select Code</span>
                <div class="cs-trigger-right">
                  <button class="cs-clear" id="cs-code-clear" onclick="event.stopPropagation();csClear('code')" style="display:none;">×</button>
                  <svg class="cs-chevron" id="cs-code-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
              </div>
              <div class="cs-panel" id="cs-code-panel" style="display:none;">
                <div class="cs-list" id="cs-code-list"></div>
              </div>
            </div>
          </div>

        </div>
        <div id="form-error" class="form-error"></div>
      </div>
    </div>

    <div class="form-spacer"></div>

    <!-- Bottom actions -->
    <div class="bottom-actions">
      <button class="btn-check" id="search-btn" onclick="handleSearch()">
        Check Fines
        <div class="btn-icon">
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
      </button>
    </div>

  </div><!-- /main-area -->
</div><!-- /app-layout -->

