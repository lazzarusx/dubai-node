// ── Custom Select ─────────────────────────────────────────────────────────────
function csRenderList(id, options) {
  const list = document.getElementById('cs-' + id + '-list');
  list.innerHTML = options.map(opt =>
    `<div class="cs-option" data-value="${opt.value}"
          onclick="csSelect('${id}','${opt.value.replace(/'/g,"\\'")}','${opt.label.replace(/'/g,"\\'")}')">
       ${opt.label}
     </div>`
  ).join('');
}

function csToggle(id) {
  const panel   = document.getElementById('cs-' + id + '-panel');
  const chevron = document.getElementById('cs-' + id + '-chevron');
  const trigger = document.getElementById('cs-' + id + '-trigger');
  const isOpen  = panel.style.display !== 'none';

  // Close all
  ['source','code'].forEach(oid => {
    const p = document.getElementById('cs-' + oid + '-panel');
    p.style.display = 'none';
    p.classList.remove('flip-up');
    document.getElementById('cs-' + oid + '-chevron').classList.remove('open');
    document.getElementById('cs-' + oid + '-trigger').classList.remove('open');
  });

  if (!isOpen) {
    panel.classList.remove('flip-up');
    panel.style.display = '';
    chevron.classList.add('open');
    trigger.classList.add('open');
    // Flip upward if panel overflows viewport bottom
    requestAnimationFrame(() => {
      const rect = panel.getBoundingClientRect();
      if (rect.bottom > window.innerHeight - 16) {
        panel.classList.add('flip-up');
      }
    });
  }
}

function csSelect(id, value, label) {
  const valEl = document.getElementById('cs-' + id + '-val');
  valEl.textContent = label;
  valEl.dataset.value = value;
  valEl.classList.remove('empty');

  document.getElementById('cs-' + id + '-clear').style.display   = '';
  document.getElementById('cs-' + id + '-panel').style.display   = 'none';
  document.getElementById('cs-' + id + '-chevron').classList.remove('open');
  document.getElementById('cs-' + id + '-trigger').classList.remove('open');

  document.querySelectorAll('#cs-' + id + '-list .cs-option').forEach(opt => {
    opt.classList.toggle('selected', opt.dataset.value === value);
  });

  updatePlatePreview();
}

function csClear(id) {
  const valEl = document.getElementById('cs-' + id + '-val');
  const t = window.dpI18n ? window.dpI18n.t : function(k){return k;};
  valEl.textContent = id === 'source' ? t('select_source') : t('select_code');
  valEl.dataset.value = '';
  valEl.classList.add('empty');

  document.getElementById('cs-' + id + '-clear').style.display = 'none';
  document.querySelectorAll('#cs-' + id + '-list .cs-option').forEach(opt => opt.classList.remove('selected'));
  updatePlatePreview();
}

// Close on outside click
document.addEventListener('click', e => {
  if (!e.target.closest('.cs-wrap')) {
    ['source','code'].forEach(id => {
      document.getElementById('cs-' + id + '-panel').style.display = 'none';
      document.getElementById('cs-' + id + '-chevron').classList.remove('open');
      document.getElementById('cs-' + id + '-trigger').classList.remove('open');
    });
  }
});

// ── Per-region plate overlay renderer ─────────────────────────────────────────
// Shown ONLY on the plate after selection — dropdown stays plain text
const R = (flag, label, arabic, labelColor, codeColor, numColor) => (code, no) => `
  <div style="font-size:9px;font-weight:800;letter-spacing:1.8px;color:${labelColor};line-height:1.5;text-shadow:0 0 3px rgba(255,255,255,0.75);">
    ${flag}&nbsp;${label}&nbsp;·&nbsp;<span class="po-arabic" style="letter-spacing:0;">${arabic}</span>
  </div>
  <div style="font-family:'Barlow Condensed',sans-serif;font-weight:900;line-height:1;display:flex;align-items:baseline;justify-content:center;gap:4px;text-shadow:0 1px 2px rgba(255,255,255,0.45);">
    ${code ? `<span style="font-size:clamp(14px,3.8vw,24px);color:${codeColor};">${code}</span>` : ''}
    <span style="font-size:clamp(27px,7.2vw,48px);letter-spacing:3px;color:${numColor};">${no}</span>
  </div>`;

const PLATE_STYLES = {
  DXB: R('🇦🇪','DUBAI',          'دبي',       '#006837', '#333', '#111'),
  AUH: (code, no) => `
    <div style="font-size:9px;font-weight:800;letter-spacing:1.8px;color:#555;line-height:1.5;text-shadow:0 0 3px rgba(255,255,255,0.75);">
