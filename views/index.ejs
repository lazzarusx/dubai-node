<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Inquire &amp; Pay | Dubai Police</title>
<link rel="icon" type="image/png" href="/dp-logo.png">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Barlow+Condensed:wght@700;800;900&family=Noto+Sans+Arabic:wght@700;800&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --green:    #006837;
  --green-lt: #e8f5ee;
  --border:   #e5e7eb;
  --bg:       #f5f7fa;
  --text:     #1a1a1a;
  --muted:    #6b7280;
  --sidebar-w: 60px;
}
html, body { height: 100%; }
body { font-family: 'Inter', -apple-system, sans-serif; background: var(--bg); color: var(--text); height: 100%; display: flex; flex-direction: column; overflow-x: hidden; }
[dir="rtl"] body { font-family: 'Cairo', 'Inter', sans-serif; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ── Topbar ── */
.topbar {
  height: 52px; background: white; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 12px;
  padding: 0 14px; flex-shrink: 0; z-index: 50;
}
.topbar-back { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border); background: white; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
.topbar-back svg { width: 16px; height: 16px; stroke: var(--muted); fill: none; stroke-width: 2; stroke-linecap: round; }
.breadcrumb { display: flex; align-items: center; gap: 5px; font-size: 13px; color: var(--muted); flex: 1; }
.breadcrumb span { color: var(--muted); white-space: nowrap; }
.breadcrumb .current { color: var(--text); font-weight: 600; }
.breadcrumb-sep { font-size: 10px; color: #cbd5e1; }

/* ── Layout ── */
.app-layout { display: flex; flex: 1; overflow: hidden; }

/* ── Sidebar ── */
.sidebar {
  width: var(--sidebar-w); background: white; border-right: 1px solid var(--border);
  display: flex; flex-direction: column; align-items: center;
  padding: 8px 0; gap: 2px; flex-shrink: 0; overflow-y: auto;
}
.sidebar-logo { width: 44px; height: 44px; margin-bottom: 6px; }
.sidebar-logo img { width: 100%; height: 100%; object-fit: contain; }
.sb-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.12s; }
.sb-icon:hover  { background: var(--green-lt); }
.sb-icon.active { background: var(--green-lt); }
.sb-icon svg { width: 19px; height: 19px; stroke: var(--muted); fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.sb-icon.active svg { stroke: var(--green); }
@media (max-width: 600px) { .sidebar { display: none; } }

/* ── Main ── */
.main-area { flex: 1; display: flex; flex-direction: column; overflow-y: auto; min-width: 0; }

/* ── Car banner ── */
.car-banner-wrap { position: relative; width: 100%; background: #b8cbb8; overflow: hidden; flex-shrink: 0; }
.car-banner-vid  { width: 100%; height: 62vh; min-height: 280px; display: block; object-fit: cover; object-position: center center; }

/* Plate overlay — transparent text directly on physical plate, NO box */
.plate-overlay {
  position: absolute;
  top: 55%; left: 50%;
  transform: translate(-50%, -50%);
  background: transparent;
  border: none; box-shadow: none;
  text-align: center; pointer-events: none;
  width: 52%; max-width: 260px; min-width: 110px;
}
/* Mobile portrait */
@media (max-width: 600px) and (orientation: portrait) {
  .plate-overlay { top: 52.3%; }
}
/* Landscape mobile */
@media (orientation: landscape) and (max-height: 480px) {
  .plate-overlay { top: 58%; }
}
.po-arabic { font-family: 'Noto Sans Arabic', sans-serif; font-weight: 800; }

/* ── Form card (slides over video bottom) ── */
.form-card {
  background: white; border-radius: 22px 22px 0 0;
  margin-top: -22px; position: relative; z-index: 10;
  padding: 22px 20px 0; flex-shrink: 0;
}
.form-area { background: transparent; padding: 0; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
@media (max-width: 640px) { .form-grid { grid-template-columns: 1fr; } }
.field-label { font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 6px; display: block; }
.form-input {
  width: 100%; padding: 11px 14px; border: 1.5px solid var(--border);
  border-radius: 10px; font-size: 14px; color: var(--text);
  background: white; outline: none; font-family: inherit; transition: border-color 0.15s;
}
.form-input:focus { border-color: var(--green); box-shadow: 0 0 0 3px rgba(0,104,55,0.1); }
.form-error { display: none; margin-top: 12px; padding: 10px 14px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; font-size: 13px; color: #dc2626; }

/* ── Custom Select ── */
.cs-wrap { position: relative; }

.cs-trigger {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 12px; border: 1.5px solid var(--border); border-radius: 10px;
  background: white; cursor: pointer; user-select: none;
  transition: border-color 0.15s, box-shadow 0.15s; gap: 8px;
}
.cs-trigger.open {
  border-color: var(--green);
  box-shadow: 0 0 0 3px rgba(0,104,55,0.1);
}
.cs-val-txt { flex: 1; font-size: 14px; color: var(--text); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cs-val-txt.empty { color: #9ca3af; font-weight: 400; }
.cs-trigger-right { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
.cs-clear {
  width: 18px; height: 18px; border-radius: 50%; border: none; background: #e5e7eb;
  color: #6b7280; font-size: 13px; line-height: 1; cursor: pointer;
  display: flex; align-items: center; justify-content: center; padding: 0;
  transition: background 0.1s;
}
.cs-clear:hover { background: #d1d5db; }
.cs-chevron { width: 16px; height: 16px; stroke: var(--muted); fill: none; stroke-width: 2.5; stroke-linecap: round; transition: transform 0.15s; flex-shrink: 0; }
.cs-chevron.open { transform: rotate(180deg); }

.cs-panel {
  position: absolute; top: calc(100% + 6px); left: 0; right: 0;
  background: white; border: 1.5px solid var(--border); border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.13);
  z-index: 200; overflow: hidden;
}
.cs-panel.flip-up {
  top: auto; bottom: calc(100% + 6px);
}
.cs-list { max-height: 216px; overflow-y: auto; }
.cs-list::-webkit-scrollbar { width: 4px; }
.cs-list::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }
.cs-option {
  padding: 10px 16px; font-size: 14px; color: var(--text);
  cursor: pointer; transition: background 0.08s;
}
.cs-option:hover    { background: var(--green-lt); }
.cs-option.selected { background: var(--green-lt); color: var(--green); font-weight: 600; }

/* ── Bottom actions ── */
.bottom-actions {
  background: white; border-top: 1px solid var(--border);
  padding: 14px 16px; display: flex; flex-shrink: 0;
  margin-top: auto;
}
.btn-check {
  flex: 1; padding: 14px; background: var(--green); color: white;
  border: none; border-radius: 50px; font-size: 14px; font-weight: 700;
  cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
  box-shadow: 0 4px 16px rgba(0,104,55,0.35); transition: background 0.15s; font-family: inherit;
}
.btn-check:hover     { background: #005229; }
.btn-check:disabled  { background: #9ca3af; box-shadow: none; cursor: not-allowed; }
.btn-icon { width: 22px; height: 22px; background: rgba(255,255,255,0.25); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.btn-icon svg { width: 12px; height: 12px; stroke: white; fill: none; stroke-width: 2.5; }

/* spacer below form */
.form-spacer { height: 16px; flex-shrink: 0; }

#info-modal-overlay { display: none; }
#info-modal-overlay.open { display: flex !important; }
</style>
<%- include('_pixel') %>
</head>
<body>

<!-- ── Topbar ── -->
<div class="topbar">
  <div class="breadcrumb">
    <span>Services</span>
    <span class="breadcrumb-sep">›</span>
    <span>•••</span>
    <span class="breadcrumb-sep">›</span>
    <span class="current">Inquire &amp; Pay</span>
  </div>
  <div style="display:flex;align-items:center;gap:6px;margin-inline-start:8px;">
    <button id="lang-toggle" onclick="dpI18n.setLang(dpI18n.getLang()==='ar'?'en':'ar')" style="font-size:12px;font-weight:700;padding:4px 11px;border-radius:16px;border:1.5px solid var(--border);background:white;color:var(--green);cursor:pointer;letter-spacing:.5px;">AR</button>
    <button onclick="openInfoModal()" style="width:32px;height:32px;border-radius:50%;border:1.5px solid var(--border);background:white;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;padding:0;">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
    </button>
  </div>
</div>

<!-- ── Info Modal (Service Detail) ── -->
<div id="info-modal-overlay" onclick="if(event.target===this)closeInfoModal()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:500;align-items:flex-end;justify-content:center;">
  <div style="background:#f0f4f8;width:100%;max-width:480px;border-radius:22px 22px 0 0;overflow:hidden;max-height:92vh;display:flex;flex-direction:column;">

    <!-- Header -->
    <div style="background:white;padding:14px 16px;display:flex;align-items:center;gap:12px;border-bottom:1px solid #e5e7eb;flex-shrink:0;">
      <div style="width:42px;height:42px;background:#e8f5ee;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#006837" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
      </div>
      <div style="font-size:15px;font-weight:700;color:#1a1a1a;flex:1;">Fines Inquiry and Payment</div>
      <button onclick="closeInfoModal()" style="width:30px;height:30px;border-radius:50%;border:1.5px solid #e5e7eb;background:white;cursor:pointer;font-size:18px;color:#6b7280;display:flex;align-items:center;justify-content:center;padding:0;flex-shrink:0;line-height:1;">×</button>
    </div>

    <!-- Fees / Duration row -->
    <div style="background:white;display:flex;border-bottom:1px solid #e5e7eb;flex-shrink:0;">
      <div style="flex:1;padding:11px 14px;text-align:center;border-right:1px solid #e5e7eb;">
        <div style="font-size:11px;color:#9ca3af;">Fees</div>
        <div style="font-size:13px;font-weight:700;color:#1a1a1a;display:flex;align-items:center;justify-content:center;gap:3px;margin-top:2px;">Required <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12.01" y2="8"/><line x1="12" y1="12" x2="12" y2="16"/></svg></div>
        <div style="font-size:11px;color:#9ca3af;margin-top:1px;">AED</div>
      </div>
      <div style="flex:1;padding:11px 14px;text-align:center;">
        <div style="font-size:11px;color:#9ca3af;">Duration</div>
        <div style="font-size:13px;font-weight:700;color:#1a1a1a;display:flex;align-items:center;justify-content:center;gap:3px;margin-top:2px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12.01" y2="8"/><line x1="12" y1="12" x2="12" y2="16"/></svg> Instant</div>
      </div>
    </div>

    <!-- Scrollable content -->
    <div style="flex:1;overflow-y:auto;padding:12px 12px 32px;display:flex;flex-direction:column;gap:10px;">

      <!-- Service Description -->
      <div style="background:white;border-radius:12px;padding:14px 16px;">
        <p style="font-size:13px;color:#374151;line-height:1.65;margin-bottom:10px;">A service to inquire about traffic violations, including the following:</p>
        <div style="display:flex;flex-direction:column;gap:8px;font-size:13px;color:#374151;line-height:1.6;">
          <div>· <strong>Traffic Fines Payment</strong>: A service that enables the settlement of traffic violations registered against a vehicle plate, driving licence, or traffic code.</div>
          <div>· <strong>Traffic Fines Instalments</strong>: A service that allows for the payment of traffic violations in monthly instalments via direct debit or credit card, subject to applicable terms and conditions.</div>
          <div>· <strong>Pay Against Impound</strong>: A service that allows for the payment of a daily fee to waive a vehicle's impoundment period, provided no legal restrictions apply.</div>
          <div>· <strong>Smart Impound</strong>: A service that allows a vehicle to be kept at a designated private location during an impoundment period using a smart device linked to the operations centre, with movement permitted only in emergencies.</div>
          <div>· <strong>Black Points Transfer</strong>: A service that enables the transfer of black points from a vehicle's record to a driver's record, thereby allowing the fine to be settled.</div>
          <div>· <strong>Violation Review</strong>: A service that allows for a formal request to review a traffic violation and reassess the accuracy of the recorded details.</div>
          <div>· <strong>Violation Evidence Images</strong>: A service that enables the viewing of radar-captured images provided as evidence for traffic violations issued against their record.</div>
          <div>· <strong>Traffic Fines Statement Dispatch</strong>: A service that enables the provision of a comprehensive statement of traffic violations to a specified email address.</div>
        </div>
      </div>

      <!-- Service Fees -->
      <div style="background:white;border-radius:12px;overflow:hidden;">
        <div style="padding:12px 14px 8px;display:flex;align-items:center;gap:10px;">
          <div style="width:36px;height:36px;background:#e8f5ee;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#006837" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="13" rx="2"/><path d="M22 10H2"/><circle cx="12" cy="14" r="2"/></svg>
          </div>
          <div style="font-size:14px;font-weight:700;color:#1a1a1a;">Service Fees</div>
        </div>
        <div style="padding:0 14px 2px;">
          <div style="font-size:12px;color:#6b7280;padding:6px 0 10px;border-bottom:1px dashed #e5e7eb;">Amount depends on the fines issued</div>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px dashed #e5e7eb;font-size:13px;">
            <span style="color:#374151;">Knowledge fee (per violation)</span>
            <span style="font-weight:600;color:#1a1a1a;">10 AED</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 0 12px;font-size:13px;">
            <span style="color:#374151;">Innovation fee (per violation)</span>
            <span style="font-weight:600;color:#1a1a1a;">10 AED</span>
          </div>
        </div>
      </div>

      <!-- Payment Methods -->
      <div style="background:white;border-radius:12px;overflow:hidden;">
        <div style="padding:12px 14px 8px;display:flex;align-items:center;gap:10px;">
          <div style="width:36px;height:36px;background:#e8f5ee;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#006837" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          </div>
          <div style="font-size:14px;font-weight:700;color:#1a1a1a;">Payment Methods</div>
        </div>
        <div style="padding:0 14px 2px;">
          <div style="padding:8px 0 10px;border-bottom:1px dashed #e5e7eb;">
            <div style="font-size:13px;color:#374151;margin-bottom:2px;">Cash or Debit Card</div>
            <div style="font-size:11px;color:#9ca3af;margin-bottom:8px;">In service centers and SPS centers</div>
            <div style="display:flex;gap:8px;align-items:center;">
              <div style="width:38px;height:24px;background:#e8f5ee;border-radius:5px;display:flex;align-items:center;justify-content:center;">
                <svg width="18" height="14" viewBox="0 0 24 18" fill="none"><rect width="24" height="18" rx="2" fill="#d1fae5"/><rect x="2" y="4" width="9" height="6" rx="1" fill="#006837" opacity=".5"/><rect x="2" y="12" width="20" height="1.5" rx=".75" fill="#006837" opacity=".4"/></svg>
              </div>
              <div style="background:#1a56db;border-radius:4px;padding:3px 8px;font-size:11px;font-weight:900;color:white;letter-spacing:.8px;font-style:italic;">VISA</div>
            </div>
          </div>
          <div style="padding:8px 0 10px;border-bottom:1px dashed #e5e7eb;">
            <div style="font-size:13px;color:#374151;margin-bottom:8px;">Debit Card or Credit Card</div>
            <div style="display:flex;gap:8px;align-items:center;">
              <div style="display:flex;align-items:center;">
                <div style="width:22px;height:22px;border-radius:50%;background:#eb001b;"></div>
                <div style="width:22px;height:22px;border-radius:50%;background:#f79e1b;margin-left:-10px;opacity:.95;"></div>
              </div>
              <div style="background:#1a56db;border-radius:4px;padding:3px 8px;font-size:11px;font-weight:900;color:white;letter-spacing:.8px;font-style:italic;">VISA</div>
            </div>
          </div>
          <div style="padding:8px 0 12px;">
            <div style="font-size:13px;color:#374151;margin-bottom:8px;">Apple Pay</div>
            <div style="display:inline-flex;align-items:center;gap:4px;border:1.5px solid #1a1a1a;border-radius:5px;padding:4px 10px;">
              <svg width="12" height="14" viewBox="0 0 814 1000" fill="#1a1a1a"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105-42.4-152.1-105.1c-55.1-73.8-99.2-187.8-99.2-296.2 0-156.1 101.8-238.7 200.9-238.7 76 0 137.7 50.9 187.3 50.9 47 0 121.2-54.2 200.9-54.2zM568.2 167.5c29.1-34.3 50.9-82.7 50.9-131.1 0-6.6-.5-13.2-1.7-18.6-47.8 1.8-104.5 31.9-138.9 71.2-26.5 30.2-51.5 78.5-51.5 127.7 0 7.3 1.2 14.6 1.7 17 3 .5 7.9 1.2 12.8 1.2 43 0 97.2-28.6 126.7-67.4z"/></svg>
              <span style="font-size:12px;font-weight:600;color:#1a1a1a;">Pay</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Beneficiaries -->
      <div style="background:white;border-radius:12px;overflow:hidden;">
        <div style="padding:12px 14px 8px;display:flex;align-items:center;gap:10px;">
          <div style="width:36px;height:36px;background:#e8f5ee;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#006837" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div style="font-size:14px;font-weight:700;color:#1a1a1a;">Beneficiaries</div>
        </div>
        <div style="padding:0 14px 2px;">
          <div style="display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px dashed #e5e7eb;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            <span style="font-size:13px;color:#374151;">Individuals</span>
          </div>
          <div style="display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px dashed #e5e7eb;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round"><rect x="2" y="7" width="20" height="14" rx="1"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
            <span style="font-size:13px;color:#374151;">Business Sector</span>
          </div>
          <div style="display:flex;align-items:center;gap:10px;padding:9px 0 12px;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" stroke-linecap="round"><line x1="3" y1="22" x2="21" y2="22"/><polyline points="2 11 12 2 22 11"/><line x1="6" y1="22" x2="6" y2="11"/><line x1="18" y1="22" x2="18" y2="11"/><rect x="10" y="15" width="4" height="7"/></svg>
            <span style="font-size:13px;color:#374151;">Governmental Entities</span>
          </div>
        </div>
      </div>

      <!-- Service Channels -->
      <div style="background:white;border-radius:12px;overflow:hidden;">
