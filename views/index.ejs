<script>
const DUBAI_PLATE_CODES = [
  {code:"A",id:"2"},{code:"B",id:"3"},{code:"C",id:"4"},{code:"D",id:"5"},
  {code:"E",id:"6"},{code:"G",id:"68"},{code:"H",id:"70"},{code:"I",id:"71"},
  {code:"J",id:"78"},{code:"K",id:"80"},{code:"L",id:"74"},{code:"M",id:"69"},
  {code:"N",id:"95"},{code:"O",id:"88"},{code:"P",id:"96"},{code:"Q",id:"93"},
  {code:"R",id:"79"},{code:"S",id:"87"},{code:"T",id:"97"},{code:"U",id:"98"},
  {code:"V",id:"86"},{code:"W",id:"99"},{code:"X",id:"100"},{code:"Y",id:"102"},
  {code:"Z",id:"101"},{code:"AA",id:"700"},{code:"BB",id:"754"},{code:"CC",id:"755"},
  {code:"DD",id:"757"},{code:"HH",id:"764"},{code:"NN",id:"756"},{code:"TAXI",id:"8"}
];
const ABU_DHABI_PLATE_CODES = [
  {code:"1",id:"712"},{code:"2",id:"711"},{code:"4",id:"137"},{code:"5",id:"72"},
  {code:"6",id:"81"},{code:"7",id:"138"},{code:"8",id:"139"},{code:"9",id:"140"},
  {code:"10",id:"110"},{code:"11",id:"135"},{code:"12",id:"141"},{code:"13",id:"169"},
  {code:"14",id:"674"},{code:"15",id:"679"},{code:"16",id:"173"},{code:"17",id:"693"},
  {code:"18",id:"730"},{code:"19",id:"744"},{code:"20",id:"750"},{code:"21",id:"762"},
  {code:"22",id:"769"},{code:"50",id:"696"},{code:"1★",id:"699"}
];
const CATEGORIES = {DXB:"2",AUH:"2",SHJ:"2",AJM:"2",UAQ:"2",RAK:"2",FUJ:"2"};
const EMIRATE_NAMES = {DXB:'Dubai',AUH:'Abu Dhabi',SHJ:'Sharjah',AJM:'Ajman',UAQ:'Umm Al Quwain',RAK:'Ras Al Khaimah',FUJ:'Fujairah'};

let activeTab = 'plate';

function setTab(id) {
  ['plate','licence','tc','fines'].forEach(t => {
    const btn = document.getElementById('tab-' + t);
    if (btn) btn.classList.toggle('active', t === id);
  });
  activeTab = id;
  document.getElementById('tab-plate-content').style.display = id === 'plate' ? '' : 'none';
  const other = document.getElementById('tab-other-content');
  other.style.display = id !== 'plate' ? 'flex' : 'none';
}

function onPlateSrcChange(src) {
  const wrapper = document.getElementById('plateCodeWrapper');
  document.getElementById('plateCode') && (document.getElementById('plateCode').value = '');
  updatePlatePreview();

  if (src === 'DXB' || src === 'AUH') {
    const codes = src === 'DXB' ? DUBAI_PLATE_CODES : ABU_DHABI_PLATE_CODES;
    const opts = '<option value="">Select Code</option>' + codes.map(c => `<option value="${c.code}">${c.code}</option>`).join('');
    wrapper.innerHTML = `<div class="field-wrap"><select id="plateCode" class="form-select" onchange="updatePlatePreview()" style="padding-right:36px;">${opts}</select><div class="select-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></div></div>`;
  } else {
    const disabled = !src;
    wrapper.innerHTML = `<div class="field-wrap"><input type="text" id="plateCode" class="form-input" placeholder="${src ? 'Enter plate code' : 'Select source first'}" oninput="updatePlatePreview()" maxlength="5" ${disabled ? 'disabled style="background:#f5f5f5;cursor:not-allowed;"' : ''}></div>`;
  }
}

function updatePlatePreview() {
  const no = (document.getElementById('plateNo')?.value || '').trim();
  const codeEl = document.getElementById('plateCode');
  const code = codeEl ? codeEl.value : '';
  const src = document.getElementById('plateSrc')?.value || '';

  const ph = document.getElementById('plate-placeholder');
  const srcD = document.getElementById('plate-src-display');
  const uaeD = document.getElementById('plate-uae-text');
  const codeD = document.getElementById('plate-code-display');
  const numD = document.getElementById('plate-num-display');

  if (no && code && src) {
    ph.style.display = 'none';
    srcD.textContent = EMIRATE_NAMES[src] || src;
    srcD.style.display = '';
    uaeD.style.display = '';
    codeD.textContent = code;
    codeD.style.display = '';
    numD.textContent = no;
    numD.style.display = '';
  } else if (no || code) {
    ph.style.display = 'none';
    srcD.style.display = src ? '' : 'none';
    if (src) srcD.textContent = EMIRATE_NAMES[src] || src;
    uaeD.style.display = '';
    codeD.style.display = code ? '' : 'none';
    if (code) codeD.textContent = code;
    numD.style.display = no ? '' : 'none';
    if (no) numD.textContent = no;
  } else {
    ph.style.display = '';
    srcD.style.display = 'none';
    uaeD.style.display = 'none';
    codeD.style.display = 'none';
    numD.style.display = 'none';
  }
}

function getPlateCodeId(emirate, code) {
  if (emirate === 'DXB') { const f = DUBAI_PLATE_CODES.find(c => c.code === code.toUpperCase()); return f ? f.id : '0'; }
  if (emirate === 'AUH') { const f = ABU_DHABI_PLATE_CODES.find(c => c.code === code); return f ? f.id : '0'; }
  return code;
}

function showError(msg) { const el = document.getElementById('form-error'); el.textContent = msg; el.style.display = ''; }
function hideError() { document.getElementById('form-error').style.display = 'none'; }

function handleSearch() {
  hideError();
  const plateSrc = document.getElementById('plateSrc').value;
  const plateNo  = (document.getElementById('plateNo').value || '').trim();
  const codeEl   = document.getElementById('plateCode');
  const plateCode = codeEl ? codeEl.value : '';

  if (!plateSrc)  { showError('Please select a plate source.'); return; }
  if (!plateNo)   { showError('Please enter your plate number.'); return; }
  if (!plateCode) { showError('Please select or enter a plate code.'); return; }

  const btn = document.getElementById('search-btn');
  btn.disabled = true;
  btn.innerHTML = '<span style="width:18px;height:18px;border:3px solid rgba(255,255,255,0.35);border-top-color:white;border-radius:50%;display:inline-block;animation:spin 0.8s linear infinite;"></span>';

  const plateCodeId = getPlateCodeId(plateSrc, plateCode);
  const plateCat = CATEGORIES[plateSrc] || '2';
  const params = new URLSearchParams({plateNo, plateCat, plateSrcCode: plateSrc, plateCodeId, plateCodeLetter: plateCode.toUpperCase()});
  window.location.href = '/fines?' + params.toString();
}
</script>
</body>
</html>
