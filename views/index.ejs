    </div>
    ${no ? `<div class="po-arabic" style="font-size:clamp(18px,5vw,32px);font-weight:900;color:#006c35;letter-spacing:2px;text-shadow:0 1px 2px rgba(255,255,255,0.5);">${reverseDigitsToArabic(no)}${code ? ' ' + toArabicLetter(code) : ''}</div>` : ''}
    <div style="font-family:'Barlow Condensed',sans-serif;font-weight:900;line-height:1;display:flex;align-items:baseline;justify-content:center;gap:4px;text-shadow:0 1px 2px rgba(255,255,255,0.45);">
