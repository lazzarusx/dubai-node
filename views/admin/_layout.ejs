<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= pageTitle %> — Admin Panel</title>
<link rel="icon" type="image/png" href="/dp-logo.png">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ── Theme variables ─────────────────────────────────────── */
:root {
  --bg-page:    #f1f5f9;
  --bg-card:    #ffffff;
  --bg-topbar:  #ffffff;
  --bg-thead:   #f8fafc;
  --bg-row-hov: #f8fafc;
  --bg-input:   #fafafa;
  --bd:         #e2e8f0;
  --bd-light:   #f1f5f9;
  --tx-base:    #0f172a;
  --tx-muted:   #94a3b8;
  --tx-mid:     #475569;
  --tx-head:    #64748b;
  --tx-label:   #374151;
  --filter-bg:  #ffffff;
}
.dark {
  --bg-page:    #0d1117;
  --bg-card:    #161b22;
  --bg-topbar:  #161b22;
  --bg-thead:   #1c2128;
  --bg-row-hov: #1c2128;
  --bg-input:   #0d1117;
  --bd:         #30363d;
  --bd-light:   #21262d;
  --tx-base:    #e6edf3;
  --tx-muted:   #6e7681;
  --tx-mid:     #8b949e;
  --tx-head:    #8b949e;
  --tx-label:   #c9d1d9;
  --filter-bg:  #161b22;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
  background: var(--bg-page); color: var(--tx-base);
  min-height: 100vh; display: flex; font-size: 14px; line-height: 1.5;
  transition: background 0.2s, color 0.2s;
}

/* ── Sidebar ─────────────────────────────────────────── */
.sidebar { width: 220px; flex-shrink: 0; background: #0c1a2e; display: flex; flex-direction: column; min-height: 100vh; position: sticky; top: 0; height: 100vh; overflow-y: auto; }

.sidebar-brand { padding: 18px 16px; border-bottom: 1px solid rgba(255,255,255,0.06); display: flex; align-items: center; gap: 10px; }
.brand-icon { width: 34px; height: 34px; background: #006837; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.brand-icon svg { width: 18px; height: 18px; fill: none; stroke: white; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.brand-name { font-size: 13px; font-weight: 700; color: white; line-height: 1.2; }
.brand-sub  { font-size: 10px; color: rgba(255,255,255,0.3); margin-top: 1px; }

.sidebar-nav { padding: 10px 8px; flex: 1; }
.nav-label { font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.2); letter-spacing: 0.9px; text-transform: uppercase; padding: 10px 10px 4px; margin-top: 4px; }
.nav-link { display: flex; align-items: center; gap: 9px; padding: 8px 10px; border-radius: 6px; margin-bottom: 1px; text-decoration: none; color: rgba(255,255,255,0.45); font-size: 13px; font-weight: 500; transition: all 0.12s; border: 1px solid transparent; }
.nav-link:hover  { background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.8); }
.nav-link.active { background: rgba(0,104,55,0.18); color: #6ee7b7; border-color: rgba(0,104,55,0.35); }
.nav-link svg { width: 15px; height: 15px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

.sidebar-footer { padding: 12px 16px; border-top: 1px solid rgba(255,255,255,0.06); }
.sidebar-footer .sf-user { font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.5); margin-bottom: 5px; }
.sidebar-footer a { font-size: 12px; color: rgba(255,255,255,0.3); text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }
.sidebar-footer a:hover { color: #6ee7b7; }
.sidebar-footer a svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

/* ── Main ────────────────────────────────────────────── */
.main { flex: 1; display: flex; flex-direction: column; min-width: 0; }

.topbar { background: var(--bg-topbar); border-bottom: 1px solid var(--bd); padding: 0 28px; height: 56px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 40; transition: background 0.2s; }
.topbar-title { font-size: 15px; font-weight: 700; color: var(--tx-base); }
.topbar-date  { font-size: 12px; color: var(--tx-muted); margin-left: 10px; }
.topbar-right { display: flex; align-items: center; gap: 8px; }

.user-pill { background: var(--bg-page); border: 1px solid var(--bd); border-radius: 20px; padding: 5px 14px; font-size: 12px; font-weight: 600; color: var(--tx-mid); display: flex; align-items: center; gap: 6px; }
.user-dot  { width: 7px; height: 7px; background: #006837; border-radius: 50%; }

/* Theme toggle button */
.theme-toggle { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--bd); background: var(--bg-page); color: var(--tx-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
.theme-toggle:hover { border-color: #006837; color: #006837; }
.theme-toggle svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

.content { padding: 24px 28px; flex: 1; }

/* ── Stat cards ──────────────────────────────────────── */
.stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px; margin-bottom: 24px; }
.stat-card { background: var(--bg-card); border-radius: 12px; padding: 20px; border: 1px solid var(--bd); transition: background 0.2s; }
.stat-label { font-size: 11px; font-weight: 600; color: var(--tx-muted); text-transform: uppercase; letter-spacing: 0.5px; }
.stat-value { font-size: 30px; font-weight: 800; color: var(--tx-base); line-height: 1; margin-top: 8px; }
.stat-sub   { font-size: 12px; color: var(--tx-muted); margin-top: 6px; }
.stat-card.c-green  .stat-value { color: #006837; }
.stat-card.c-blue   .stat-value { color: #1d4ed8; }
.stat-card.c-amber  .stat-value { color: #b45309; }

/* ── Tables ──────────────────────────────────────────── */
.table-card { background: var(--bg-card); border-radius: 12px; border: 1px solid var(--bd); overflow: hidden; margin-bottom: 20px; transition: background 0.2s; }
.tc-header { padding: 14px 20px; border-bottom: 1px solid var(--bd-light); display: flex; align-items: center; justify-content: space-between; }
.tc-title  { font-size: 14px; font-weight: 700; color: var(--tx-base); }
.tc-meta   { font-size: 12px; color: var(--tx-muted); }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
thead th { background: var(--bg-thead); padding: 9px 16px; text-align: left; font-size: 11px; font-weight: 700; color: var(--tx-head); text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--bd); white-space: nowrap; }
tbody td { padding: 11px 16px; border-bottom: 1px solid var(--bd-light); vertical-align: middle; color: var(--tx-base); }
tbody tr:last-child td { border-bottom: none; }
tbody tr:hover td { background: var(--bg-row-hov); }

/* ── User status dot ─────────────────────────────────── */
.status-dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
.status-dot.active  { background: #22c55e; box-shadow: 0 0 0 2px rgba(34,197,94,0.25); }
.status-dot.recent  { background: #f59e0b; box-shadow: 0 0 0 2px rgba(245,158,11,0.25); }
.status-dot.offline { background: var(--bd); }

/* ── Badges ──────────────────────────────────────────── */
.badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
.b-pending  { background: #fef3c7; color: #92400e; }
.b-approved { background: #dcfce7; color: #166534; }
.b-declined { background: #fee2e2; color: #991b1b; }
.b-otp      { background: #e0e7ff; color: #3730a3; }
.b-received { background: #dbeafe; color: #1e40af; }

/* ── Buttons ─────────────────────────────────────────── */
.btn { display: inline-flex; align-items: center; gap: 5px; padding: 7px 14px; border-radius: 7px; font-size: 12px; font-weight: 600; cursor: pointer; border: none; text-decoration: none; transition: opacity 0.15s; white-space: nowrap; }
.btn:hover { opacity: 0.85; }
.btn-sm { padding: 4px 9px; font-size: 11px; }
.btn-primary { background: #006837; color: white; }
.btn-blue    { background: #1d4ed8; color: white; }
.btn-amber   { background: #b45309; color: white; }
.btn-red     { background: #dc2626; color: white; }
.btn-ghost   { background: var(--bg-thead); color: var(--tx-mid); border: 1px solid var(--bd); }
.btn-purple  { background: #6d28d9; color: white; }
.action-bar  { display: flex; gap: 4px; flex-wrap: wrap; }

/* ── Forms ───────────────────────────────────────────── */
.form-section { background: var(--bg-card); border-radius: 12px; border: 1px solid var(--bd); padding: 20px 24px; margin-bottom: 20px; }
.form-section-title { font-size: 14px; font-weight: 700; color: var(--tx-base); margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--bd-light); }
.form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 14px; }
.form-group label { display: block; font-size: 12px; font-weight: 600; color: var(--tx-label); margin-bottom: 5px; }
.form-group input[type=text],
.form-group input[type=password],
.form-group select {
  width: 100%; padding: 8px 12px; border: 1.5px solid var(--bd); border-radius: 7px;
  font-size: 13px; outline: none; transition: border-color 0.15s;
  background: var(--bg-input); color: var(--tx-base);
}
.form-group input:focus, .form-group select:focus { border-color: #006837; }
.form-help { font-size: 11px; color: var(--tx-muted); margin-top: 4px; }

.filter-bar { background: var(--filter-bg); border-radius: 10px; border: 1px solid var(--bd); padding: 14px 20px; margin-bottom: 16px; display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end; }
.filter-bar input, .filter-bar select {
  padding: 7px 12px; border: 1.5px solid var(--bd); border-radius: 7px;
  font-size: 13px; outline: none; background: var(--bg-input); color: var(--tx-base);
}
.filter-bar input:focus, .filter-bar select:focus { border-color: #006837; }

/* ── Alerts ──────────────────────────────────────────── */
.alert { padding: 10px 16px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; }
.alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
.alert-error   { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }

/* ── Toast ───────────────────────────────────────────── */
#toast { position: fixed; bottom: 24px; right: 24px; background: #0f172a; color: white; padding: 12px 18px; border-radius: 8px; font-size: 13px; font-weight: 600; z-index: 9999; opacity: 0; transform: translateY(8px); transition: all 0.25s; pointer-events: none; }
#toast.show    { opacity: 1; transform: translateY(0); }
#toast.success { background: #006837; }
#toast.error   { background: #dc2626; }

/* ── Auto-refresh bar ────────────────────────────────── */
#refresh-bar { display: none; background: #006837; color: white; font-size: 12px; font-weight: 600; padding: 7px 20px; text-align: center; cursor: pointer; }
#refresh-bar:hover { background: #005229; }

/* ── Utilities ───────────────────────────────────────── */
.mono   { font-family: 'SFMono-Regular', Consolas, monospace; font-size: 12px; }
.muted  { color: var(--tx-muted); }
.small  { font-size: 12px; }
.nowrap { white-space: nowrap; }
.select-all { user-select: all; cursor: text; }
.text-green { color: #006837; font-weight: 700; }
</style>
</head>
<body>

<div class="sidebar">
  <div class="sidebar-brand">
    <div class="brand-icon">
      <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    </div>
    <div>
      <div class="brand-name">Dubai Panel</div>
      <div class="brand-sub">Admin Control</div>
    </div>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-label">Overview</div>
    <a href="/admin/dashboard" class="nav-link <%= activePage === 'dashboard' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      Dashboard
    </a>
    <div class="nav-label">Data</div>
    <a href="/admin/payments" class="nav-link <%= activePage === 'payments' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
      Payments
    </a>
    <a href="/admin/inquiries" class="nav-link <%= activePage === 'inquiries' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      Inquiries
    </a>
    <div class="nav-label">System</div>
    <a href="/admin/settings" class="nav-link <%= activePage === 'settings' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      Settings
    </a>
  </nav>

  <div class="sidebar-footer">
    <div class="sf-user"><%= adminUser %></div>
    <a href="/admin/logout">
      <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Sign out
    </a>
  </div>
</div>

<div class="main">
  <div id="refresh-bar" onclick="location.reload()">New payments received — Click to refresh</div>
  <div class="topbar">
    <div style="display:flex;align-items:center;">
      <div class="topbar-title"><%= pageTitle %></div>
      <span class="topbar-date" id="topbar-date"></span>
    </div>
    <div class="topbar-right">
      <button class="theme-toggle" id="theme-btn" onclick="toggleTheme()" title="Toggle dark mode">
        <svg id="theme-icon-moon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg id="theme-icon-sun"  viewBox="0 0 24 24" style="display:none"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
      <div class="user-pill">
        <div class="user-dot"></div>
        <%= adminUser %>
      </div>
    </div>
  </div>
  <div class="content">
