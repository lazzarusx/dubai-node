<%- include('_layout', { pageTitle: 'Inquiries', activePage: 'inquiries', adminUser }) %>

<% if (typeof dbError !== 'undefined' && dbError) { %>
<div class="alert alert-error">Database error: <%= dbError %></div>
<% } else { %>

<div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr));margin-bottom:20px;">
  <div class="stat-card c-blue">
    <div class="stat-label">Total Inquiries</div>
    <div class="stat-value"><%= Number(total).toLocaleString() %></div>
  </div>
  <div class="stat-card c-amber">
    <div class="stat-label">Today</div>
    <div class="stat-value"><%= Number(todayCount).toLocaleString() %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Unique IPs</div>
    <div class="stat-value"><%= Number(uniqueIPs).toLocaleString() %></div>
  </div>
  <div class="stat-card c-green">
    <div class="stat-label">With Fines</div>
    <div class="stat-value"><%= Number(withFines).toLocaleString() %></div>
  </div>
</div>

<div class="filter-bar">
  <form method="GET" action="/admin/inquiries" style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;width:100%;">
    <div class="form-group" style="flex:1;">
      <label>Search (plate, source, code, IP)</label>
      <input type="text" name="q" value="<%= search %>" placeholder="e.g. 12345, DXB, A, 192.168...">
    </div>
    <div style="display:flex;gap:8px;align-items:flex-end;">
      <button type="submit" class="btn btn-primary" style="margin-bottom:1px;">Filter</button>
      <a href="/admin/inquiries" class="btn btn-ghost" style="margin-bottom:1px;">Clear</a>
    </div>
  </form>
</div>

<div class="table-card">
  <div class="tc-header">
    <div class="tc-title">Plate Inquiries</div>
    <div class="tc-meta"><%= total %> records</div>
  </div>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr><th>#</th><th>Date</th><th>Plate</th><th>Fines</th><th>Total AED</th><th>IP</th><th>SID</th><th></th></tr>
    </thead>
    <tbody>
    <% if (rows.length === 0) { %>
    <tr><td colspan="8" style="text-align:center;padding:40px;color:#94a3b8;">No records found.</td></tr>
    <% } %>
    <% rows.forEach(function(r) {
      const dt = r.created_at ? new Date(r.created_at).toLocaleString('en-AE',{timeZone:'Asia/Dubai',day:'2-digit',month:'2-digit',year:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit'}) : '-';
      const sidShort = r.sid ? r.sid.slice(0,10) + '…' : '—';
    %>
    <tr id="inq-row-<%= r.id %>">
      <td class="muted small"><%= r.id %></td>
      <td class="small nowrap"><%= dt %></td>
      <td><strong><%= r.plate_src %></strong> <%= r.plate_code %> <%= r.plate_no %></td>
      <td>
        <% if (r.fine_count > 0) { %>
          <strong style="color:#dc2626;"><%= r.fine_count %></strong>
        <% } else { %>
          <span class="muted">0</span>
        <% } %>
      </td>
      <td>
        <% if (r.total_amount > 0) { %>
          <strong>AED <%= Number(r.total_amount).toLocaleString() %></strong>
        <% } else { %>
          <span class="muted">—</span>
        <% } %>
      </td>
      <td class="mono muted small"><%= r.ip || '—' %></td>
      <td class="mono muted small" title="<%= r.sid || '' %>"><%= sidShort %></td>
      <td>
        <button type="button" class="btn btn-sm" onclick="deleteInquiry(<%= r.id %>)"
          style="border:1px solid #dc2626;color:#dc2626;background:transparent;cursor:pointer;"
          title="Delete this inquiry">🗑</button>
      </td>
    </tr>
    <% }) %>
    </tbody>
  </table>
  </div>

  <% if (totalPages > 1) { %>
  <div style="padding:14px 20px;display:flex;gap:6px;justify-content:center;border-top:1px solid #f1f5f9;">
    <% for (let i = 1; i <= totalPages; i++) { %>
    <a href="/admin/inquiries?p=<%= i %>&q=<%= encodeURIComponent(search) %>"
       class="btn btn-sm <%= i === page ? 'btn-primary' : 'btn-ghost' %>"><%= i %></a>
    <% } %>
  </div>
  <% } %>
</div>

<% } %>

<script>
async function deleteInquiry(id) {
  if (!confirm('Delete this inquiry permanently?')) return;
  try {
    const r = await fetch('/admin/inquiries/' + id + '/delete', { method: 'POST', credentials: 'same-origin' });
    const d = await r.json();
    if (d.ok) {
      const row = document.getElementById('inq-row-' + id);
      if (row) row.remove();
      if (typeof toast === 'function') toast('Inquiry deleted');
    } else {
      if (typeof toast === 'function') toast(d.error || 'Delete failed', 'error');
      else alert(d.error || 'Delete failed');
    }
  } catch (e) {
    if (typeof toast === 'function') toast('Connection error', 'error');
    else alert('Connection error');
  }
}
</script>

<%- include('_layout_end') %>
