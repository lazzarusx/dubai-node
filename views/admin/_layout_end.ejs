  </div><!-- /content -->
</div><!-- /main -->

<div id="toast"></div>
<script>
document.getElementById('topbar-date').textContent = new Date().toLocaleString('en-AE', { timeZone: 'Asia/Dubai', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });

function toast(msg, type = 'success') {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = 'show ' + type;
  setTimeout(() => { el.className = ''; }, 3000);
}

async function adminAction(data) {
  const form = new URLSearchParams(data);
  try {
    const r = await fetch('/admin/action', { method: 'POST', body: form });
    const d = await r.json();
    if (d.ok) { toast('Action completed successfully'); setTimeout(() => location.reload(), 700); }
    else toast(d.error || 'Action failed', 'error');
  } catch (e) { toast('Connection error', 'error'); }
}
</script>
</body>
</html>
