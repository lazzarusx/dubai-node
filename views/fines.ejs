<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Review Fines | Dubai Police</title>
<link rel="icon" type="image/png" href="/dp-logo.png">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --green:     #006837;
  --green-lt:  #e8f5ee;
  --border:    #e5e7eb;
  --bg:        #f5f7fa;
  --text:      #1a1a1a;
  --muted:     #6b7280;
  --red:       #dc2626;
  --sidebar-w: 60px;
}
html { height: 100%; }
body { font-family: 'Inter', -apple-system, sans-serif; background: var(--bg); color: var(--text); height: 100%; display: flex; flex-direction: column; overflow: hidden; }
@keyframes spin  { to { transform: rotate(360deg); } }
@keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:0.5; } }

/* ── Topbar ── */
.topbar {
  height: 52px; background: white; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 12px;
  padding: 0 14px; flex-shrink: 0; z-index: 50;
}
.topbar-back { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border); background: white; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
.topbar-back svg { width: 16px; height: 16px; stroke: var(--muted); fill: none; stroke-width: 2; stroke-linecap: round; }
.breadcrumb { display: flex; align-items: center; gap: 5px; font-size: 12px; color: var(--muted); flex: 1; overflow: hidden; }
.breadcrumb span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.breadcrumb .current { color: var(--text); font-weight: 600; }
.breadcrumb-sep { font-size: 10px; color: #cbd5e1; flex-shrink: 0; }
.topbar-icons { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.topbar-icon { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--border); background: white; display: flex; align-items: center; justify-content: center; cursor: pointer; }
.topbar-icon svg { width: 14px; height: 14px; stroke: var(--muted); fill: none; stroke-width: 2; }
.lang-btn { padding: 4px 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 12px; font-weight: 600; color: var(--text); background: white; cursor: pointer; }
.sos-btn  { padding: 4px 12px; background: var(--red); color: white; border: none; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; }
.login-btn { display: flex; align-items: center; gap: 5px; font-size: 12px; color: var(--muted); cursor: pointer; background: none; border: none; }

/* ── Body wrapper ── */
.body-wrap { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.app-layout { flex: 1; display: flex; overflow: hidden; }

/* ── Sidebar ── */
.sidebar {
  width: var(--sidebar-w); background: white; border-right: 1px solid var(--border);
  display: flex; flex-direction: column; align-items: center;
  padding: 8px 0; gap: 2px; flex-shrink: 0; overflow-y: auto;
}
.sidebar-logo { width: 44px; height: 44px; margin-bottom: 6px; }
.sidebar-logo img { width: 100%; height: 100%; object-fit: contain; }
.sb-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.12s; }
.sb-icon:hover  { background: var(--green-lt); }
.sb-icon.active { background: var(--green-lt); }
.sb-icon svg { width: 19px; height: 19px; stroke: var(--muted); fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.sb-icon.active svg { stroke: var(--green); }
@media (max-width: 600px) { .sidebar { display: none; } }

/* ── Main area ── */
.main-area { flex: 1; display: flex; flex-direction: column; overflow-y: auto; min-width: 0; }

/* ── Loading ── */
.loading-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 60px 20px; }
.spinner-ring  { width: 44px; height: 44px; border: 3.5px solid #e5e7eb; border-top-color: var(--green); border-radius: 50%; animation: spin 0.8s linear infinite; }
.loading-txt   { font-size: 14px; color: var(--muted); animation: pulse 1.5s ease-in-out infinite; }

/* ── Error ── */
.error-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 40px 20px; text-align: center; }
.error-icon { width: 56px; height: 56px; background: #fef2f2; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.error-icon svg { width: 24px; height: 24px; stroke: var(--red); fill: none; stroke-width: 2; }
.error-title   { font-size: 17px; font-weight: 700; color: var(--text); }
.error-sub     { font-size: 13px; color: var(--muted); max-width: 300px; }
.btn-retry     { padding: 12px 28px; background: var(--green); color: white; border: none; border-radius: 50px; font-size: 14px; font-weight: 700; cursor: pointer; }

/* ── Results ── */
#results-screen { flex: 1; display: flex; flex-direction: column; }

/* Page header */
.page-header { background: white; border-bottom: 1px solid var(--border); padding: 14px 18px; display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-shrink: 0; }
.page-title    { font-size: 18px; font-weight: 800; color: var(--text); line-height: 1.2; }
.page-subtitle { font-size: 12px; color: var(--muted); margin-top: 3px; }
.mobile-hint   { font-size: 12px; color: var(--green); margin-top: 4px; font-weight: 600; }

/* Plate badge */
.plate-badge { background: white; border: 2px solid #d1d5db; border-radius: 8px; padding: 6px 12px 5px; text-align: center; min-width: 100px; flex-shrink: 0; box-shadow: 0 2px 8px rgba(0,0,0,0.07); }
.plate-badge-top { font-size: 9.5px; font-weight: 700; color: var(--muted); letter-spacing: 0.5px; border-bottom: 1px solid var(--border); padding-bottom: 3px; margin-bottom: 4px; display: flex; align-items: center; justify-content: center; gap: 5px; }
.plate-badge-row { display: flex; align-items: baseline; justify-content: center; gap: 5px; }
.plate-badge-code { font-size: 13px; font-weight: 800; color: #444; }
.plate-badge-num  { font-size: 17px; font-weight: 900; color: var(--text); letter-spacing: 1.5px; line-height: 1; }

/* Discount banner */
.discount-banner { margin: 12px 16px 0; background: linear-gradient(135deg,#dc2626,#b91c1c); border-radius: 12px; padding: 10px 14px; display: flex; align-items: center; gap: 10px; color: white; flex-shrink: 0; }
.disc-badge { margin-left: auto; background: white; color: var(--red); font-weight: 800; font-size: 13px; padding: 4px 10px; border-radius: 20px; white-space: nowrap; flex-shrink: 0; }

/* Filter tabs */
.filter-tabs { background: white; border-bottom: 1px solid var(--border); padding: 0 14px; display: flex; overflow-x: auto; scrollbar-width: none; flex-shrink: 0; margin-top: 12px; }
.filter-tabs::-webkit-scrollbar { display: none; }
.ftab { padding: 10px 13px; border: none; background: none; font-size: 12px; font-weight: 500; color: var(--muted); cursor: pointer; white-space: nowrap; border-bottom: 2.5px solid transparent; margin-bottom: -1px; transition: all 0.12s; display: flex; align-items: center; gap: 5px; }
.ftab.active { font-weight: 700; color: var(--green); border-bottom-color: var(--green); }
.fcnt { background: #e5e7eb; color: #374151; font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 20px; line-height: 1.7; }
.ftab.active .fcnt { background: var(--green-lt); color: var(--green); }

/* Select bar */
.select-bar { display: flex; gap: 8px; align-items: center; padding: 10px 16px 6px; flex-shrink: 0; }
.sel-btn   { padding: 5px 13px; border: 1.5px solid var(--green); background: var(--green-lt); color: var(--green); border-radius: 20px; font-size: 12px; font-weight: 700; cursor: pointer; }
.clear-btn { padding: 5px 13px; border: 1.5px solid #fca5a5; background: #fef2f2; color: var(--red); border-radius: 20px; font-size: 12px; font-weight: 700; cursor: pointer; }

/* Cards */
.cards-area { flex: 1; padding: 12px 16px 20px; display: flex; flex-direction: column; gap: 12px; }

.fine-card { background: white; border-radius: 14px; border: 1.5px solid var(--border); overflow: hidden; transition: border-color 0.14s, box-shadow 0.14s; }
.fine-card.payable { cursor: pointer; }
.fine-card.payable:active { opacity: 0.9; }
.fine-card.selected { border-color: var(--green); box-shadow: 0 0 0 3px rgba(0,104,55,0.1); }

.card-top { padding: 12px 14px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #f1f5f9; }
.cb-box { width: 20px; height: 20px; border-radius: 6px; border: 2px solid #d1d5db; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.12s; background: white; }
.cb-box.checked { background: var(--green); border-color: var(--green); }
.cb-box svg { display: none; width: 11px; height: 11px; stroke: white; fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
.cb-box.checked svg { display: block; }

.badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; white-space: nowrap; }
.badge-payable  { background: #dcfce7; color: #15803d; }
.badge-impound  { background: #fef3c7; color: #b45309; }
.badge-bp       { background: #ede9fe; color: #6d28d9; }
.badge-other    { background: #f1f5f9; color: var(--muted); }

.card-amount { margin-left: auto; text-align: right; flex-shrink: 0; }
.orig-amt  { font-size: 13px; color: #9ca3af; text-decoration: line-through; text-decoration-thickness: 2.5px; line-height: 1.3; }
.disc-amt  { font-size: 18px; font-weight: 900; color: var(--green); line-height: 1; }
.disc-amt.muted { color: var(--muted); font-size: 16px; }

.card-body { padding: 8px 14px 2px; }
.info-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 6px 0; border-bottom: 1px solid #f8fafc; font-size: 12px; }
.info-row:last-child { border-bottom: none; }
.info-key { color: var(--muted); flex-shrink: 0; margin-right: 12px; }
.info-val { font-weight: 600; color: var(--text); text-align: right; }

.card-detail { background: #f8fafc; margin: 2px 14px 12px; border-radius: 10px; padding: 10px 12px; }
.detail-title { font-size: 10px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 5px; }
.detail-text  { font-size: 13px; font-weight: 600; color: var(--text); line-height: 1.4; }
.detail-extra { font-size: 11px; color: var(--muted); margin-top: 4px; }

/* Empty */
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; gap: 12px; text-align: center; }
.empty-icon  { width: 56px; height: 56px; background: var(--green-lt); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.empty-icon svg { width: 26px; height: 26px; stroke: var(--green); fill: none; stroke-width: 1.5; stroke-linecap: round; }
.empty-title { font-size: 17px; font-weight: 700; color: var(--text); }
.empty-sub   { font-size: 13px; color: var(--muted); max-width: 280px; }

/* Bottom bar */
.bottom-bar { background: white; border-top: 1px solid var(--border); padding: 12px 16px 14px; flex-shrink: 0; }
.bottom-summary { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.bottom-left-lbl  { font-size: 13px; font-weight: 600; color: var(--text); }
.bottom-disc-lbl  { font-size: 11px; color: var(--green); font-weight: 600; margin-top: 2px; }
.bottom-total     { font-size: 22px; font-weight: 900; color: var(--text); }
.btn-pay {
  width: 100%; padding: 15px; background: var(--green); color: white;
  border: none; border-radius: 50px; font-size: 15px; font-weight: 700;
  cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;
  box-shadow: 0 4px 16px rgba(0,104,55,0.3); transition: background 0.15s;
}
.btn-pay:hover    { background: #005229; }
.btn-pay:disabled { background: #9ca3af; box-shadow: none; cursor: not-allowed; opacity: 0.7; }
</style>
<%- include('_pixel') %>
</head>
<body>

<!-- ── Topbar ── -->
<div class="topbar">
  <div class="topbar-back" onclick="history.back()">
    <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
  </div>
  <div class="breadcrumb">
    <span>Services</span>
    <span class="breadcrumb-sep">›</span>
    <span>•••</span>
    <span class="breadcrumb-sep">›</span>
    <span>Inquire &amp; Pay</span>
    <span class="breadcrumb-sep">›</span>
    <span class="current">Review Fines</span>
  </div>
</div>

<div class="body-wrap">
  <div class="app-layout">

    <!-- ── Sidebar ── -->
    <div class="sidebar">
      <div class="sidebar-logo"><img src="/dp-logo.png" alt="Dubai Police"></div>
    </div>

    <!-- ── Main ── -->
    <div class="main-area">

      <!-- Loading -->
      <div id="loading-screen" class="loading-wrap">
        <div class="spinner-ring"></div>
        <div class="loading-txt">Checking fines...</div>
      </div>

      <!-- Error -->
      <div id="error-screen" style="display:none;" class="error-wrap">
        <div class="error-icon">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div class="error-title">Unable to Load Fines</div>
        <div class="error-sub" id="error-msg">Could not retrieve fines. Please try again.</div>
        <button class="btn-retry" onclick="window.location.href='/'">← Try Again</button>
      </div>

      <!-- Results -->
      <div id="results-screen" style="display:none;">

        <!-- Page header -->
        <div class="page-header">
          <div>
            <div class="page-title">Review Fines</div>
            <div class="page-subtitle" id="fine-count-label"></div>
            <div class="mobile-hint" id="mobile-number-line" style="display:none;"></div>
          </div>
          <div class="plate-badge">
            <div class="plate-badge-top">
              <span id="badge-src"></span>
              <span style="color:#cbd5e1;">·</span>
              <span>UAE</span>
            </div>
            <div class="plate-badge-row">
              <span class="plate-badge-code" id="badge-code"></span>
              <span class="plate-badge-num"  id="badge-num"></span>
            </div>
          </div>
        </div>

        <!-- Discount banner -->
        <div class="discount-banner">
          <div>
            <div style="font-weight:800;font-size:14px;">50% Fine Discount Active</div>
            <div style="font-size:11px;opacity:0.9;">Limited time offer — pay today and save 50% on your fines</div>
          </div>
          <div class="disc-badge">-50%</div>
        </div>

        <!-- Filter tabs -->
        <div class="filter-tabs">
          <button class="ftab active" id="filter-all"       onclick="setFilter('all')">All <span class="fcnt" id="all-count">0</span></button>
          <button class="ftab"        id="filter-impound"   onclick="setFilter('impound')">Impound <span class="fcnt" id="impound-count">0</span></button>
          <button class="ftab"        id="filter-payable"   onclick="setFilter('payable')">Payable <span class="fcnt" id="payable-count">0</span></button>
          <button class="ftab"        id="filter-bp"        onclick="setFilter('bp')">Black Points <span class="fcnt" id="bp-count">0</span></button>
          <button class="ftab"        id="filter-unpayable" onclick="setFilter('unpayable')">Un Payable <span class="fcnt" id="unpayable-count">0</span></button>
        </div>

        <!-- Select actions -->
        <div id="select-actions" class="select-bar" style="display:none;">
          <button class="sel-btn" onclick="selectAll()">Select All Payable</button>
          <button class="clear-btn" id="clear-btn" style="display:none;" onclick="clearAll()">Clear</button>
        </div>

        <!-- Fine cards -->
        <div class="cards-area" id="fine-cards"></div>

      </div><!-- /results-screen -->
    </div><!-- /main-area -->
  </div><!-- /app-layout -->

  <!-- Bottom bar (outside scroll container) -->
  <div class="bottom-bar" id="bottom-bar" style="display:none;">
    <div class="bottom-summary">
      <div>
        <div class="bottom-left-lbl" id="selected-label">0 fines selected</div>
        <div class="bottom-disc-lbl">50% discount applied</div>
      </div>
      <div class="bottom-total" id="total-amount"><svg viewBox="0 0 1000 870" width="21" height="18" fill="currentColor" style="vertical-align:middle;display:inline-block;margin-right:2px;margin-bottom:2px;"><path d="m88.3 1c0.4 0.6 2.6 3.3 4.7 5.9 15.3 18.2 26.8 47.8 33 85.1 4.1 24.5 4.3 32.2 4.3 125.6v87h-41.8c-38.2 0-42.6-0.2-50.1-1.7-11.8-2.5-24-9.2-32.2-17.8-6.5-6.9-6.3-7.3-5.9 13.6 0.5 17.3 0.7 19.2 3.2 28.6 4 14.9 9.5 26 17.8 35.9 11.3 13.6 22.8 21.2 39.2 26.3 3.5 1 10.9 1.4 37.1 1.6l32.7 0.5v43.3 43.4l-46.1-0.3-46.3-0.3-8-3.2c-9.5-3.8-13.8-6.6-23.1-14.9l-6.8-6.1 0.4 19.1c0.5 17.7 0.6 19.7 3.1 28.7 8.7 31.8 29.7 54.5 57.4 61.9 6.9 1.9 9.6 2 38.5 2.4l30.9 0.4v89.6c0 54.1-0.3 94-0.8 100.8-0.5 6.2-2.1 17.8-3.5 25.9-6.5 37.3-18.2 65.4-35 83.6l-3.4 3.7h169.1c101.1 0 176.7-0.4 187.8-0.9 19.5-1 63-5.3 72.8-7.4 3.1-0.6 8.9-1.5 12.7-2.1 8.1-1.2 21.5-4 40.8-8.9 27.2-6.8 52-15.3 76.3-26.1 7.6-3.4 29.4-14.5 35.2-18 3.1-1.8 6.8-4 8.2-4.7 3.9-2.1 10.4-6.3 19.9-13.1 4.7-3.4 9.4-6.7 10.4-7.4 4.2-2.8 18.7-14.9 25.3-21 25.1-23.1 46.1-48.8 62.4-76.3 2.3-4 5.3-9 6.6-11.1 3.3-5.6 16.9-33.6 18.2-37.8 0.6-1.9 1.4-3.9 1.8-4.3 2.6-3.4 17.6-50.6 19.4-60.9 0.6-3.3 0.9-3.8 3.4-4.3 1.6-0.3 24.9-0.3 51.8-0.1 53.8 0.4 53.8 0.4 65.7 5.9 6.7 3.1 8.7 4.5 16.1 11.2 9.7 8.7 8.8 10.1 8.2-11.7-0.4-12.8-0.9-20.7-1.8-23.9-3.4-12.3-4.2-14.9-7.2-21.1-9.8-21.4-26.2-36.7-47.2-44l-8.2-3-33.4-0.4-33.3-0.5 0.4-11.7c0.4-15.4 0.4-45.9-0.1-61.6l-0.4-12.6 44.6-0.2c38.2-0.2 45.3 0 49.5 1.1 12.6 3.5 21.1 8.3 31.5 17.8l5.8 5.4v-14.8c0-17.6-0.9-25.4-4.5-37-7.1-23.5-21.1-41-41.1-51.8-13-7-13.8-7.2-58.5-7.5-26.2-0.2-39.9-0.6-40.6-1.2-0.6-0.6-1.1-1.6-1.1-2.4 0-0.8-1.5-7.1-3.5-13.9-23.4-82.7-67.1-148.4-131-197.1-8.7-6.7-30-20.8-38.6-25.6-3.3-1.9-6.9-3.9-7.8-4.5-4.2-2.3-28.3-14.1-34.3-16.6-3.6-1.6-8.3-3.6-10.4-4.4-35.3-15.3-94.5-29.8-139.7-34.3-7.4-0.7-17.2-1.8-21.7-2.2-20.4-2.3-48.7-2.6-209.4-2.6-135.8 0-169.9 0.3-169.4 1zm330.7 43.3c33.8 2 54.6 4.6 78.9 10.5 74.2 17.6 126.4 54.8 164.3 117 3.5 5.8 18.3 36 20.5 42.1 1