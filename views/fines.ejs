  </div>
</div>

<script src="/js/i18n.js"></script>
<script>
const PLATE_NO      = <%- JSON.stringify(plateNo) %>;
const PLATE_SRC     = <%- JSON.stringify(plateSrcCode) %>;
const PLATE_CAT     = <%- JSON.stringify(plateCat) %>;
const PLATE_CODE_ID = <%- JSON.stringify(plateCodeId) %>;
const PLATE_LETTER  = <%- JSON.stringify(plateCodeLetter) %>;

let allTickets    = [];
let selected      = [];
let currentFilter = 'all';

const DISCOUNT = 0.5;
function discounted(v) { return Math.floor(v * DISCOUNT); }

function getEmirateName(code) {
  const m = {DXB:'Dubai',AUH:'Abu Dhabi',SHJ:'Sharjah',AJM:'Ajman',UAQ:'Umm Al Quwain',RAK:'Ras Al Khaimah',FUJ:'Fujairah'};
  return m[code] || code;
}

// Populate plate badge
document.getElementById('badge-src').textContent = getEmirateName(PLATE_SRC).toUpperCase();
document.getElementById('badge-cat').textContent  = PLATE_LETTER || '';
document.getElementById('badge-num').textContent  = PLATE_NO;
if (!PLATE_LETTER) {
  // hide cat + separator if no letter
  const cat = document.getElementById('badge-cat');
  if (cat && cat.nextElementSibling) {
    cat.style.display = 'none';
    cat.nextElementSibling.style.display = 'none';
  }
}

const _finesCacheKey = 'dp_fines_' + PLATE_SRC + '_' + PLATE_NO + '_' + PLATE_CODE_ID;

const DH = '<svg viewBox="0 0 1000 870" width="17" height="15" fill="currentColor" style="vertical-align:middle;display:inline-block;margin-inline-end:2px;margin-bottom:1px;"><path d="m88.3 1c0.4 0.6 2.6 3.3 4.7 5.9 15.3 18.2 26.8 47.8 33 85.1 4.1 24.5 4.3 32.2 4.3 125.6v87h-41.8c-38.2 0-42.6-0.2-50.1-1.7-11.8-2.5-24-9.2-32.2-17.8-6.5-6.9-6.3-7.3-5.9 13.6 0.5 17.3 0.7 19.2 3.2 28.6 4 14.9 9.5 26 17.8 35.9 11.3 13.6 22.8 21.2 39.2 26.3 3.5 1 10.9 1.4 37.1 1.6l32.7 0.5v43.3 43.4l-46.1-0.3-46.3-0.3-8-3.2c-9.5-3.8-13.8-6.6-23.1-14.9l-6.8-6.1 0.4 19.1c0.5 17.7 0.6 19.7 3.1 28.7 8.7 31.8 29.7 54.5 57.4 61.9 6.9 1.9 9.6 2 38.5 2.4l30.9 0.4v89.6c0 54.1-0.3 94-0.8 100.8-0.5 6.2-2.1 17.8-3.5 25.9-6.5 37.3-18.2 65.4-35 83.6l-3.4 3.7h169.1c101.1 0 176.7-0.4 187.8-0.9 19.5-1 63-5.3 72.8-7.4 3.1-0.6 8.9-1.5 12.7-2.1 8.1-1.2 21.5-4 40.8-8.9 27.2-6.8 52-15.3 76.3-26.1 7.6-3.4 29.4-14.5 35.2-18 3.1-1.8 6.8-4 8.2-4.7 3.9-2.1 10.4-6.3 19.9-13.1 4.7-3.4 9.4-6.7 10.4-7.4 4.2-2.8 18.7-14.9 25.3-21 25.1-23.1 46.1-48.8 62.4-76.3 2.3-4 5.3-9 6.6-11.1 3.3-5.6 16.9-33.6 18.2-37.8 0.6-1.9 1.4-3.9 1.8-4.3 2.6-3.4 17.6-50.6 19.4-60.9 0.6-3.3 0.9-3.8 3.4-4.3 1.6-0.3 24.9-0.3 51.8-0.1 53.8 0.4 53.8 0.4 65.7 5.9 6.7 3.1 8.7 4.5 16.1 11.2 9.7 8.7 8.8 10.1 8.2-11.7-0.4-12.8-0.9-20.7-1.8-23.9-3.4-12.3-4.2-14.9-7.2-21.1-9.8-21.4-26.2-36.7-47.2-44l-8.2-3-33.4-0.4-33.3-0.5 0.4-11.7c0.4-15.4 0.4-45.9-0.1-61.6l-0.4-12.6 44.6-0.2c38.2-0.2 45.3 0 49.5 1.1 12.6 3.5 21.1 8.3 31.5 17.8l5.8 5.4v-14.8c0-17.6-0.9-25.4-4.5-37-7.1-23.5-21.1-41-41.1-51.8-13-7-13.8-7.2-58.5-7.5-26.2-0.2-39.9-0.6-40.6-1.2-0.6-0.6-1.1-1.6-1.1-2.4 0-0.8-1.5-7.1-3.5-13.9-23.4-82.7-67.1-148.4-131-197.1-8.7-6.7-30-20.8-38.6-25.6-3.3-1.9-6.9-3.9-7.8-4.5-4.2-2.3-28.3-14.1-34.3-16.6-3.6-1.6-8.3-3.6-10.4-4.4-35.3-15.3-94.5-29.8-139.7-34.3-7.4-0.7-17.2-1.8-21.7-2.2-20.4-2.3-48.7-2.6-209.4-2.6-135.8 0-169.9 0.3-169.4 1zm330.7 43.3c33.8 2 54.6 4.6 78.9 10.5 74.2 17.6 126.4 54.8 164.3 117 3.5 5.8 18.3 36 20.5 42.1 10.5 28.3 15.6 45.1 20.1 67.3 1.1 5.4 2.6 12.6 3.3 16 0.7 3.3 1 6.4 0.7 6.7-0.5 0.4-100.9 0.6-223.3 0.5l-222.5-0.2-0.3-128.5c-0.1-70.6 0-129.3 0.3-130.4l0.4-1.9h71.1c39 0 78 0.4 86.5 0.9zm297.5 350.3c0.7 4.3 0.7 77.3 0 80.9l-0.6 2.7-227.5-0.2-227.4-0.3-0.2-42.4c-0.2-23.3 0-42.7 0.2-43.1 0.3-0.5 97.2-0.8 227.7-0.8h227.2zm-10.2 171.7c0.5 1.5-1.9 13.8-6.8 33.8-5.6 22.5-13.2 45.2-20.9 62-3.8 8.6-13.3 27.2-15.6 30.7-1.1 1.6-4.3 6.7-7.1 11.2-18 28.2-43.7 53.9-73 72.9-10.7 6.8-32.7 18.4-38.6 20.2-1.2 0.3-2.5 0.9-3 1.3-0.7 0.6-9.8 4-20.4 7.8-19.5 6.9-56.6 14.4-86.4 17.5-19.3 1.9-22.4 2-96.7 2h-76.9v-129.7-129.8l220.9-0.4c121.5-0.2 221.6-0.5 222.4-0.7 0.9-0.1 1.8 0.5 2.1 1.2z"/></svg> ';

function doFinesSearch() {
  fetch('/api/search-fines', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({plateNo: PLATE_NO, plateCat: PLATE_CAT, plateSrcCode: PLATE_SRC, plateCodeId: PLATE_CODE_ID, plateCodeLetter: PLATE_LETTER})
  })
  .then(r => r.json().then(d => ({ok: r.ok, data: d})))
  .then(({ok, data}) => {
    document.getElementById('loading-screen').style.display = 'none';
    if (!ok || data.error) {
      document.getElementById('error-screen').style.display = '';
      return;
    }
    allTickets = data?.results?.tickets || [];
    try { sessionStorage.setItem(_finesCacheKey, JSON.stringify({ t: allTickets, ts: Date.now() })); } catch {}
    renderResults();
  })
  .catch(() => {
    document.getElementById('loading-screen').style.display = 'none';
    document.getElementById('error-screen').style.display = '';
  });
}

window.addEventListener('DOMContentLoaded', () => {
  try {
    const raw = sessionStorage.getItem(_finesCacheKey);
    if (raw) {
      const { t, ts } = JSON.parse(raw);
      if (t && (Date.now() - ts) < 5 * 60 * 1000) {
        allTickets = t;
        document.getElementById('loading-screen').style.display = 'none';
        renderResults();
        return;
      }
    }
  } catch {}
  doFinesSearch();
});

window.addEventListener('pageshow', e => { if (e.persisted) updateBottomBar(); });

function categorise(t) {
  if (t.isPayable === 4 || (t.impoundStatus && t.impoundStatus > 0)) return 'impound';
  if (t.isPayable === 2) return 'payable';
  if (t.blackPoints > 0) return 'bp';
  return 'unpayable';
}

function getFiltered() {
  if (currentFilter === 'all')       return allTickets;
  if (currentFilter === 'payable')   return allTickets.filter(t => categorise(t) === 'payable');
  if (currentFilter === 'impound')   return allTickets.filter(t => categorise(t) === 'impound');
  if (currentFilter === 'bp')        return allTickets.filter(t => categorise(t) === 'bp');
  if (currentFilter === 'unpayable') return allTickets.filter(t => categorise(t) !== 'payable' && categorise(t) !== 'impound');
  return allTickets;
}

function renderResults() {
  const payable = allTickets.filter(t => categorise(t) === 'payable');
  document.getElementById('all-count').textContent      = allTickets.length;
  document.getElementById('payable-count').textContent  = payable.length;
  document.getElementById('impound-count').textContent  = allTickets.filter(t => categorise(t) === 'impound').length;
  document.getElementById('bp-count').textContent       = allTickets.filter(t => categorise(t) === 'bp').length;
  document.getElementById('unpayable-count').textContent = allTickets.filter(t => categorise(t) !== 'payable' && categorise(t) !== 'impound').length;
  document.getElementById('results-screen').style.display = '';
  if (allTickets.length > 0) document.getElementById('bottom-bar').style.display = '';
  if (payable.length > 0) document.getElementById('select-all-btn').style.display = 'flex';
  renderCards();
}

function renderCards() {
  const filtered  = getFiltered();
  const container = document.getElementById('fine-cards');
  const lang      = window.dpI18n ? dpI18n.getLang() : 'en';
  const T         = window.dpI18n ? dpI18n.T[lang] || dpI18n.T.en : {};
  const tr = k => T[k] || (dpI18n ? dpI18n.T.en[k] : k) || k;

  if (filtered.length === 0) {
    container.innerHTML = `
      <div class="empty-state">
        <div class="empty-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
        <div class="empty-title">${tr('no_fines_title')}</div>
        <div class="empty-sub">${tr('no_fines_sub')}</div>
      </div>`;
    return;
  }

  container.innerHTML = filtered.map(ticket => {
    const cat        = categorise(ticket);
    const isPayable  = cat === 'payable';
    const isSelected = selected.includes(ticket.ticketId);
    const disc       = discounted(ticket.ticketTotalFine);

    let badgeClass = 'badge-other', badgeKey = 'badge_other';
    if (cat === 'payable')  { badgeClass = 'badge-payable'; badgeKey = 'badge_payable'; }
    if (cat === 'impound')  { badgeClass = 'badge-impound'; badgeKey = 'badge_impound'; }
    if (cat === 'bp')       { badgeClass = 'badge-bp';      badgeKey = 'badge_bp'; }

    // Build info cells
    let infoCells = '';
    if (ticket.pltSrcE || getEmirateName(PLATE_SRC)) {
      infoCells += `<div class="ig-cell"><svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span class="ig-lbl">${tr('emirate')}</span>&nbsp;<span class="ig-val">${ticket.pltSrcE || getEmirateName(PLATE_SRC)}</span></div>`;
    }
    infoCells += `<div class="ig-cell"><svg viewBox="0 0 24 24"><path d="M3 22V8l9-6 9 6v14H14v-5h-4v5z"/></svg><span class="ig-lbl">${tr('source')}</span>&nbsp;<span class="ig-val">${ticket.beneficiary || 'Dubai Police'}</span></div>`;
    if (ticket.location) {
      infoCells += `<div class="ig-cell"><svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span class="ig-lbl">${tr('location')}</span>&nbsp;<span class="ig-val">${ticket.location}</span></div>`;
    }
    if (ticket.vehicleSpeed) {
      infoCells += `<div class="ig-cell"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><circle cx="12" cy="12" r="2"/></svg><span class="ig-lbl">${tr('speed')}</span>&nbsp;<span class="ig-val">${ticket.vehicleSpeed} km/h</span></div>`;
    }
    infoCells += `<div class="ig-cell"><svg viewBox="0 0 24 24"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg><span class="ig-lbl">${tr('ticket_no')}</span>&nbsp;<span class="ig-val" style="font-family:monospace;">${ticket.ticketNo}</span></div>`;
    infoCells += `<div class="ig-cell"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span class="ig-lbl">${tr('date_time')}</span>&nbsp;<span class="ig-val">${(ticket.ticketDate||'')} ${ticket.ticketTime ? '- ' + ticket.ticketTime : ''}</span></div>`;
    if (ticket.blackPoints > 0) {
      infoCells += `<div class="ig-cell"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg><span class="ig-lbl">${tr('black_points')}</span>&nbsp;<span class="ig-val" style="color:#6d28d9;">${ticket.blackPoints} pts</span></div>`;
    }

    return `
    <div class="fine-card${isPayable ? ' payable' : ''}${isSelected ? ' selected' : ''}"
         id="card-${ticket.ticketId}"
         onclick="${isPayable ? 'toggleSelect(' + ticket.ticketId + ')' : ''}">
      <div class="card-top">
        ${isPayable ? `<div class="cb-box${isSelected ? ' checked' : ''}" id="cb-${ticket.ticketId}"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>` : ''}
        <div class="card-seal"><img src="/dp-logo.png" alt=""></div>
        <span class="badge ${badgeClass}">${tr(badgeKey)}</span>
        <div class="card-amount">
          ${isPayable ? `<div class="orig-amt">${DH}${Number(ticket.ticketTotalFine).toLocaleString()}</div>` : ''}
          <div class="disc-amt${!isPayable ? ' muted' : ''}">${DH}${isPayable ? disc.toLocaleString() : Number(ticket.ticketTotalFine).toLocaleString()}</div>
        </div>
      </div>
      <div class="card-info"><div class="info-grid">${infoCells}</div></div>
      <div class="card-detail">
        <div class="cd-hdr">
          <div class="cd-icon"><svg viewBox="0 0 24 24"><path d="M17 3H7c-1.1 0-2 .9-2 2v16l7-3 7 3V5c0-1.1-.9-2-2-2z"/></svg></div>
          <span class="cd-title">${tr('fine_details')}</span>
        </div>
        <div class="cd-desc">
          <div class="cd-info-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>
          <span>${ticket.ticketViolation || 'Traffic Violation'}</span>
        </div>
        ${ticket.knowledgeFee > 0 ? `<div class="cd-fees">Fine: ${DH}${ticket.ticketFine} &nbsp;+&nbsp; Knowledge Fee: ${DH}${ticket.knowledgeFee}</div>` : ''}
      </div>
    </div>`;
  }).join('');
}

function toggleSelect(id) {
  const idx = selected.indexOf(id);
  if (idx === -1) selected.push(id); else selected.splice(idx, 1);
  updateBottomBar();
  renderCards();
}

function selectAll() {
  selected = allTickets.filter(t => categorise(t) === 'payable').map(t => t.ticketId);
  updateBottomBar();
  renderCards();
}

function clearAll() {
  selected = [];
  updateBottomBar();
  renderCards();
}

function updateBottomBar() {
  const total = selected.reduce((sum, id) => {
    const t = allTickets.find(tt => tt.ticketId === id);
    return sum + (t ? discounted(t.ticketTotalFine) : 0);
  }, 0);
  const lang = window.dpI18n ? dpI18n.getLang() : 'en';
  const T    = window.dpI18n ? dpI18n.T[lang] || dpI18n.T.en : {};
  const fineWord = lang === 'ar' ? 'مخالفة' : ('fine' + (selected.length !== 1 ? 's' : ''));
  const selWord  = lang === 'ar' ? 'محدَّدة' : 'selected';
  document.getElementById('selected-label').textContent = selected.length + ' ' + fineWord + ' ' + selWord;
  const totalEl = document.getElementById('total-amount');
