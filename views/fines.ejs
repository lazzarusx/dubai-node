function setFilter(f) {
  currentFilter = f;
  ['all','impound','payable','bp','unpayable'].forEach(id => {
    document.getElementById('filter-' + id).classList.toggle('active', id === f);
  });
  renderCards();
}

function handlePay() {
  if (selected.length === 0) return;
  const total = selected.reduce((sum, id) => {
    const t = allTickets.find(tt => tt.ticketId === id);
    return sum + (t ? discounted(t.ticketTotalFine) : 0);
  }, 0);
  const violations = selected.map(id => allTickets.find(t => t.ticketId === id)?.ticketViolation).filter(Boolean).join('|');
  const params = new URLSearchParams({
    plateNo: PLATE_NO, plateSrcCode: PLATE_SRC, plateCodeLetter: PLATE_LETTER,
    totalFine: String(total), fineCount: String(selected.length), violations,
  });
  window.location.href = '/payment?' + params.toString();
}

function handleRequestList() {
  // Could email/share the fine list - for now opens print dialog
  window.print();
}

function handleMoreOptions() {
  clearAll();
}

// Re-render cards when language changes (keeps translations in dynamic content)
if (window.dpI18n) {
  const _origSetLang = dpI18n.setLang;
  dpI18n.setLang = function(lang) {
    _origSetLang(lang);
    if (allTickets.length > 0) { renderCards(); updateBottomBar(); }
  };
}
</script>
