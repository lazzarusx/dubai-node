  var TRIG = <%- JSON.stringify(locals.pixelTriggers || {}) %>;
  var HAS_FB  = !!(<%= locals.metaPixelId   ? 1 : 0 %>);
  var HAS_TTQ = !!(<%= locals.tiktokPixelId ? 1 : 0 %>);
  function fire(name) {
    if (HAS_FB  && window.fbq) window.fbq('track', name);
    if (HAS_TTQ && window.ttq) window.ttq.track(name);
